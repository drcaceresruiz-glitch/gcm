# Next.js build + TS artefactos
/.next/
next-env.d.ts
*.tsbuildinfo

# Cliente Prisma generado (se regenera con `prisma generate`)
/src/generated/

# `storage/` es el cajon de lo que NO se versiona: volcados de la base (datos
# sensibles), la evidencia subida en desarrollo (en prod vive fuera del arbol)
# y los scripts sueltos de verificacion.
#
# Se ignora la CARPETA ENTERA, no solo `*.sql`. Antes solo estaban excluidos
# los volcados, asi que cualquier script de apoyo que se dejara ahi aparecia
# como archivo nuevo y podia colarse en un commit —y este repositorio es
# PUBLICO—. Nada de lo que vive en `storage/` tiene que viajar.
/storage/

# Documentos de referencia (binarios pesados; se guardan en local)
/docs/referencias/

# Repositorios de terceros descargados para estudio (1,8 GB de ZIPs).
# Son material de consulta local: NUNCA deben entrar al repositorio.
/docs/COMUNIDADGIT/

# Archivos de bloqueo de Word/Office (aparecen al tener un .doc abierto)
**/~$*

# Andamiaje de skills/agentes (no es codigo de la app)
/.agents/
/.claude/
/.windsurf/
skills-lock.json

# El Libro de Reclamaciones y el registro de pagos llevan datos personales
# (nombre, documento, domicilio, correo). No se versionan jamás: se respaldan
# aparte.
checkout/datos/

# La regla `.env.*` de arriba se llevaba por delante el .env.example del
# checkout, que es justo lo contrario de un secreto: es la plantilla vacía que
# dice QUÉ credenciales hacen falta. Sin ella, quien clone no sabe qué pedirle a
# Izipay. Se exceptúa a mano; el .env de verdad sigue ignorado.
!checkout/.env.example
