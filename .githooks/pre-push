#!/bin/sh
#
# El criterio G6, delante del push.
#
# POR QUE EN pre-push Y NO EN pre-commit: en este repositorio **cada push a
# `main` despliega a produccion**. El commit es barato y se rehace; el push no.
# Y colgarlo del commit obligaria a esperar en cada guardado intermedio, que es
# como se acaba usando `--no-verify` por costumbre —y entonces el gancho no
# protege nada—.
#
# SON CUATRO, en el mismo orden que el CI, porque cada uno tapa el punto ciego
# del otro: el LINT rechaza lo que el resto tolera (el 20/08 los deploys #435 y
# #436 murieron en el Lint del CI por `any` en los dobles de test, y G6 no lo
# miraba); vitest no comprueba tipos; `tsc` no ve las consultas de Prisma; y
# `build` es lo unico que reproduce el fallo del CI (el #344 se cayo con
# typecheck y test en verde). Ver la memoria de pruebas de servicio.
#
# Para saltarselo un dia concreto:  git push --no-verify

set -e

echo "-> typecheck"
npm run typecheck

echo "-> lint (lo que tumbo los deploys #435/#436)"
npm run lint

echo "-> pruebas"
npm test

echo "-> build (lo que corre el CI)"
npm run build

echo "OK G6: los cuatro pasan. Adelante."
