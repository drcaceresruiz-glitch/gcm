# Credenciales del checkout de GCM — copie este archivo a `.env` y rellénelo.
#
# `.env` NO se versiona (está en .gitignore). Este ejemplo sí, para que se sepa
# qué hay que pedirle a Izipay sin tener que abrir el código.
#
# Las cuatro credenciales salen del Back Office de Izipay, en
# Configuración → Tienda → Claves de API REST. Ahí aparecen las de PRUEBAS y las
# de PRODUCCIÓN por separado: empiece por las de pruebas.

# Número de tienda (8 dígitos). Es el mismo para pruebas y producción.
IZIPAY_USERNAME=

# Clave de la API REST.
#   pruebas:    testpassword_XXXXXXXXXXXXXXXX
#   producción: prodpassword_XXXXXXXXXXXXXXXX
# Es SECRETA: no viaja al navegador ni aparece en el repositorio.
IZIPAY_PASSWORD=

# Clave pública del cliente JavaScript. Esta sí llega al navegador: es su
# función. Tiene la forma  12345678:testpublickey_XXXXXXXXXXXX
IZIPAY_PUBLIC_KEY=

# Clave HMAC-SHA256. Con ella se comprueba que la respuesta del pago viene de
# Izipay. También es SECRETA.
IZIPAY_HMAC_SHA256=

# Servidor de la API. Para Izipay Perú es este, tanto en pruebas como en
# producción: lo que cambia es la clave, no la dirección.
IZIPAY_ENDPOINT=https://api.micuentaweb.pe

# Puerto en el que escucha este checkout.
PORT=3001

# Dónde queda publicado esto de cara a internet, SIN barra final. No cambia el
# funcionamiento: sirve para que al arrancar se impriman las dos URL exactas que
# hay que pegar en el Back Office de Izipay, y no haya que escribirlas a mano.
#
#   URL de notificación al final del pago (IPN)  →  <URL_PUBLICA>/api/ipn
#   URL de retorno de la tienda                  →  <URL_PUBLICA>/retorno
#
# Las dos tienen que ir en HTTPS. La de notificación se configura en
# Configuración → Reglas de notificaciones; la de retorno, en la pestaña
# Configuración de la tienda.
URL_PUBLICA=https://drcaceresruiz.com
