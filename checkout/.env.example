# Credenciales del checkout de GCM — copie este archivo a `.env` y rellénelo.
#
# `.env` NO se versiona (está en .gitignore). Este ejemplo sí, para que se sepa
# qué hay que pedirle a Izipay sin tener que abrir el código.
#
# Las cuatro credenciales salen del Back Office de Izipay, en
# Configuración → Tienda → Claves de API REST. Ahí aparecen las de PRUEBAS y las
# de PRODUCCIÓN por separado: empiece por las de pruebas.

# Número de tienda (8 dígitos). Es el mismo para pruebas y producción.
IZIPAY_USERNAME=

# Clave de la API REST.
#   pruebas:    testpassword_XXXXXXXXXXXXXXXX
#   producción: prodpassword_XXXXXXXXXXXXXXXX
# Es SECRETA: no viaja al navegador ni aparece en el repositorio.
IZIPAY_PASSWORD=

# Clave pública del cliente JavaScript. Esta sí llega al navegador: es su
# función. Tiene la forma  12345678:testpublickey_XXXXXXXXXXXX
IZIPAY_PUBLIC_KEY=

# Clave HMAC-SHA256. Con ella se comprueba la vuelta del pago POR EL NAVEGADOR.
# OJO: la notificación de servidor a servidor (IPN) NO se firma con esta, sino
# con la contraseña de arriba. También es SECRETA.
IZIPAY_HMAC_SHA256=

# --- Las claves del OTRO modo -------------------------------------------------
# La misma URL de notificación sirve a test y a producción, pero cada modo firma
# con SUS claves. Si aquí arriba están las de test y llega una notificación de
# producción, se rechazaría por firma —con todo aparentemente bien configurado—.
#
# Rellene estas dos con las del modo que NO esté usando arriba, y las
# notificaciones de los dos modos se verifican sin tocar nada más. Se usan SOLO
# para verificar lo que entra; los cobros se crean siempre con la de arriba.
# Puede dejarlas vacías mientras solo trabaje en un modo.
IZIPAY_PASSWORD_ALTERNA=
IZIPAY_HMAC_SHA256_ALTERNA=

# Servidor de la API. Para Izipay Perú es este, tanto en pruebas como en
# producción: lo que cambia es la clave, no la dirección.
IZIPAY_ENDPOINT=https://api.micuentaweb.pe

# --- Boletas y facturas (NubeFact) -------------------------------------------
# Sin estas dos, el checkout funciona igual pero NO emite comprobantes: quedan
# para emitir a mano desde NubeFact y anotar su número en el panel.
#
# Salen de su cuenta de NubeFact, en «API (Integración)». OJO: la cuenta DEMO y
# la de PRODUCCIÓN tienen RUTA y TOKEN distintos. Con las de demo no se emite
# nada ante SUNAT — sirven para probar, que es justo lo que hay que hacer antes.
NUBEFACT_RUTA=
NUBEFACT_TOKEN=

# Las series con las que se numeran los comprobantes. Cuatro caracteres exactos:
# empiezan por F las facturas y por B las boletas. En la cuenta demo son FFF1 y
# BBB1; en producción, las que tenga dadas de alta (normalmente F001 y B001).
NUBEFACT_SERIE_FACTURA=FFF1
NUBEFACT_SERIE_BOLETA=BBB1

# Que NubeFact le mande el PDF del comprobante al comprador. Póngalo en `false`
# solo si va a mandarlo usted: apagarlo sin sustituirlo deja al cliente sin nada.
NUBEFACT_AVISAR_AL_CLIENTE=true

# --- El panel del administrador ----------------------------------------------
# La contraseña con la que USTED entra en /admin a ver las compras.
#
# SIN ESTA LÍNEA EL PANEL NO SE ABRE, y es a propósito: ahí se ven nombres,
# documentos, correos y teléfonos de compradores. Que el fallo por omisión sea
# «cerrado» y no «abierto para todos».
#
# Elija una larga y que no use en ningún otro sitio. No la escriba en un correo
# ni en un chat: se pega aquí y ya está.
ADMIN_PASSWORD=

# Opcional. Con qué se firman las cookies de la sesión del panel. Si se deja
# vacío se deriva de la contraseña de arriba, que es lo razonable: cambiar la
# contraseña cierra de golpe todas las sesiones abiertas.
ADMIN_SECRET=

# Puerto en el que escucha este checkout.
PORT=3001

# Dónde queda publicado esto de cara a internet, SIN barra final. No cambia el
# funcionamiento: sirve para que al arrancar se impriman las dos URL exactas que
# hay que pegar en el Back Office de Izipay, y no haya que escribirlas a mano.
#
#   URL de notificación al final del pago (IPN)  →  <URL_PUBLICA>/api/ipn
#   URL de retorno de la tienda                  →  <URL_PUBLICA>/retorno
#
# Las dos tienen que ir en HTTPS. La de notificación se configura en
# Configuración → Reglas de notificaciones; la de retorno, en la pestaña
# Configuración de la tienda.
URL_PUBLICA=https://drcaceresruiz.com
