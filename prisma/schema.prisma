// GCM - Gestor de Construccion y Mantenimiento
// Esquema de datos - Fase 1 (Cimientos: Modulos 0 y 1)
//
// Reglas duras del modelo:
//  - Todo importe monetario es Decimal(14,2). Jamas Float.
//  - Los metrados y precios unitarios usan Decimal(14,4) por precision de obra.
//  - La linea base (Baseline) es inmutable una vez aprobada.
//  - Todo dato pertenece a una Company. El aislamiento es la frontera de seguridad.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enumeraciones
// ---------------------------------------------------------------------------

/// Roles del sistema. El rol efectivo se resuelve por obra (ProjectMembership),
/// no por usuario global.
enum Role {
  ADMIN
  RESIDENTE
  ADMIN_OBRA
  ALMACENERO
  CONSULTOR
  /// Ve el negocio entero -toda la cartera, todo lo que se lee- pero no
  /// administra ni aprueba nada. Ver `TODO_LO_QUE_SE_LEE` en `src/lib/rbac.ts`.
  GERENTE
}

enum UserState {
  ACTIVO
  INACTIVO
}

/**
 * Que hace para la empresa quien esta en el catalogo.
 * NO son dos tablas, y esa es la decision: quien ejecuta una partida y quien
 * vende el cemento tienen la misma identidad —un RUC—, la misma cuenta y la
 * misma consulta a SUNAT. Ademas, en GCM el que se compromete en el plan
 * semanal y el que carga tareas del Lookahead YA es el proveedor: separarlos
 * habria partido en dos el catalogo del que dependen esas pantallas.
 * Lo que si hacia falta era poder DISTINGUIRLOS al mirar la lista, que es lo
 * unico que este campo resuelve.
 */
enum RolProveedor {
  /// Vende materiales o alquila equipos. Lo que habia hasta ahora.
  PROVEEDOR
  /// Ejecuta trabajo en obra: se le dan frentes y se le valoriza.
  CONTRATISTA
  /// Las dos cosas. Es mas comun de lo que parece.
  AMBOS
}

/// Estado de una solicitud de cambio de datos de perfil.
enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum ProjectState {
  PLANIFICACION
  EN_EJECUCION
  PARALIZADA
  CERRADA
}

/// Nivel del arbol de la EDT. CAPITULO agrupa; PARTIDA lleva el metrado y el costo.
enum WbsType {
  CAPITULO
  PARTIDA
}

/// Modalidad de contratacion de la partida.
///
/// No es una etiqueta: cambia como se calcula el importe, como se valoriza
/// el avance y quien asume el riesgo si el metrado real difiere del previsto.
enum ModalidadPartida {
  /// Importe = metrado x precio unitario. El metrado real se mide y se
  /// valoriza; si difiere del previsto, el costo cambia.
  PRECIOS_UNITARIOS

  /// Precio cerrado por el alcance completo. El metrado es referencial:
  /// aunque se ejecute mas o menos, el importe pactado no cambia y el
  /// riesgo lo asume el contratista.
  SUMA_ALZADA

  /// Detalle del alcance dentro de una partida a suma alzada. Lleva
  /// metrado para describir que incluye, pero no tiene importe propio:
  /// el dinero esta en su partida padre.
  ALCANCE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
}

// ---------------------------------------------------------------------------
// Empresa y personas
// ---------------------------------------------------------------------------

model Company {
  id          String  @id @default(cuid())
  razonSocial String  @db.VarChar(200)
  ruc         String  @unique @db.VarChar(11)
  direccion   String? @db.VarChar(255)
  telefono    String? @db.VarChar(30)
  email       String? @db.VarChar(150)

  /// Quien firma las ordenes. Sale en el pie del documento que se le manda
  /// al proveedor, sobre la linea de firma.
  representanteLegal String? @db.VarChar(150)
  cargoRepresentante String? @db.VarChar(100)

  /// El logo de la constructora: cabecera del panel, informe en PDF y correos.
  ///
  /// SOLO PNG Y JPG, y no es un capricho de gusto: el informe lo dibuja
  /// `pdf-lib`, que unicamente sabe incrustar esos dos. Aceptar SVG o WebP
  /// daria un logo que se ve en la web y NO en el papel que recibe el
  /// cliente, que es justo donde mas se nota.
  ///
  /// Ruta RELATIVA a `STORAGE_ROOT`, como la galeria y la evidencia: el
  /// archivo vive fuera del arbol de la aplicacion para que un despliegue no
  /// se lo lleve por delante.
  logoRuta String? @db.VarChar(255)
  logoMime String? @db.VarChar(100)

  /// SHA-256 del contenido. Sirve de version para el navegador: la direccion
  /// del logo lleva `?v=<hash>`, asi que al cambiarlo se ve el nuevo sin
  /// esperar a que caduque la cache.
  logoHash String? @db.VarChar(64)

  /// El tamano REAL del archivo, medido de sus bytes al subirlo (no de lo que
  /// diga el formulario). Sin la proporcion no se puede colocar el logo en el
  /// PDF ni en el correo sin deformarlo, y deformarlo es lo unico que no se
  /// puede hacer: se lee como descuido de la empresa que lo manda.
  logoAncho Int?
  logoAlto  Int?

  /// Texto que se repite al pie de todas las ordenes del cliente, sobre la
  /// responsabilidad del traslado. Va en la empresa y no escrito en el
  /// codigo porque es una condicion contractual suya, no del sistema.
  observacionesOrden String? @db.Text

  /// Contador del proximo correlativo de obra de esta empresa. Solo sube: al
  /// crear una obra se incrementa y su valor previo se le asigna. Que viva
  /// aqui —y no se derive del maximo de las obras— es lo que hace que borrar
  /// una obra NO recicle su numero: un correlativo de auditoria no se repite.
  siguienteCorrelativoObra Int @default(1)

  activa                   Boolean  @default(true)
  /// Si el admin puede "ver como" otro rol sin salir de su cuenta. Apagado
  /// por defecto: es una herramienta para empezar con un equipo chico o para
  /// que el admin pruebe la app por rol, no algo que toda empresa necesite
  /// encendido. Ver `src/lib/vista-rol.ts`: la interseccion de permisos hace
  /// que esto sea inofensivo aunque se manipule, este ajuste solo decide si
  /// el control aparece.
  permitirVistaPreviaRoles Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  users                User[]
  projects             Project[]
  permisos             CompanyPermission[]
  proveedores          Proveedor[]
  ordenes              OrdenCompra[]
  formasPago           FormaPagoPlantilla[]
  plantillasMensaje    PlantillaMensaje[]
  solicitudesPerfil    SolicitudCambioPerfil[]
  emisoresSms          EmisorSms[]
  mensajesSms          MensajeSms[]
  /// Los proveedores de IA que esta empresa guardo (varios posibles, cada
  /// uno con su propia clave). Cual esta EN USO lo dice `proveedorIaActivo`
  /// abajo, no un booleano por fila.
  proveedoresIa        AgenteIaProveedor[]     @relation("ProveedoresDeLaEmpresa")
  proveedorIaActivoId  String?
  /// Puntero al UNO activo. Se elige un puntero en `Company` y no un
  /// booleano `activo` en `AgenteIaProveedor` a proposito: por construccion
  /// no puede haber dos activos a la vez, sin depender de una transaccion
  /// que lo garantice. `onDelete: SetNull` es la red de seguridad; el
  /// servicio ademas lo limpia el mismo al borrar (ver `agente-ia.service.ts`).
  proveedorIaActivo    AgenteIaProveedor?      @relation("ProveedorActivo", fields: [proveedorIaActivoId], references: [id], onDelete: SetNull)
  mensajesSoporte      MensajeSoporte[]
  conversacionesAgente ConversacionAgente[]
  // `respaldosObra` ya NO es relacion: sus recibos tienen que sobrevivir al
  // borrado de la empresa. Ver `RespaldoObra`.
  /// Singular, no lista: «desde donde sale mi correo» solo admite una
  /// respuesta. Ver `RemitenteCorreo`.
  remitenteCorreo      RemitenteCorreo?

  /**
   * Desde cuando la empresa esta EN MIGRACION. Null = opera normal.
   * NO es lo mismo que suspenderla, y la diferencia es justo el motivo de que
   * exista: una empresa suspendida no deja entrar a NADIE suyo
   * (`auth.service`), asi que su ADMIN no podria lanzar la exportacion de sus
   * propios datos. En migracion si entra, pero **no puede escribir**.
   * Es la doctrina de «obra cerrada» un piso mas arriba: lo que hace coherente
   * al archivo exportado es que nadie escriba mientras se lee, y el respaldo
   * de obra ya se apoya en eso mismo.
   * Se guarda la FECHA y no un booleano, como `analizadaAt` o `verificadoAt`:
   * asi el manifiesto del archivo puede decir desde cuando estaba congelada, y
   * una empresa que lleva tres semanas «migrando» se ve de un vistazo.
   */
  enMigracionAt DateTime?

  /**
   * Registro MANUAL de licencia, del area del operador. Ninguna pasarela de
   * pago detras: son tres campos para anotar lo que ya se sabe por fuera
   * -que plan tiene, hasta cuando, y notas de pago- porque hoy no hay
   * ningun sitio donde verlo sin preguntarle a la persona que vendio.
   * Ningun campo de estos GOBIERNA nada: una licencia vencida no bloquea
   * el acceso ni suspende la empresa por si sola -eso lo sigue decidiendo
   * `activa`, a mano-. Confundir "vencida" con "suspendida" seria dar por
   * hecho un cobro automatico que este registro no hace.
   */
  licenciaModalidad String?   @db.VarChar(30)
  licenciaVence     DateTime? @db.Date
  licenciaNotas     String?   @db.Text

  @@map("companies")
}

/// El telefono que manda los SMS de UNA empresa.
///
/// Existe porque hasta el 12 de agosto de 2026 habia un unico
/// SMS_COLA_TOKEN para toda la plataforma. Con una sola constructora daba
/// igual; con dos, los codigos de acceso de una saldrian por el movil de la
/// otra. Cada empresa tiene ahora los suyos.
///
/// Se guarda el HASH del token, nunca el token: igual que las sesiones y los
/// codigos del pase. Al vincular se ensena una vez en pantalla y no se puede
/// volver a ver; si se pierde, se revoca y se crea otro.
///
/// Puede haber VARIOS por empresa a proposito: un telefono de respaldo evita
/// que la obra se quede sin SMS porque uno se quedo sin bateria.
model EmisorSms {
  id        String @id @default(cuid())
  companyId String

  /// Como lo llama la gente: "el de la caseta", "telefono de Juan". Sirve
  /// para saber cual revocar cuando haya dos.
  etiqueta String @db.VarChar(80)

  /// El celular de ese telefono, en nueve cifras, si se sabe. GCM no manda
  /// nada A este numero por su cuenta —no es el quien envia, sino el telefono—,
  /// pero SI se usa: con el se prepara el WhatsApp con los pasos y el token al
  /// vincularlo, y sirve para saber que aparato es sin ir a buscarlo.
  numero String? @db.VarChar(20)

  tokenHash String @unique @db.Char(64)

  /// Revocar no borra: la fila queda para saber que existio y quien lo puso.
  activo Boolean @default(true)

  /// Ultima vez que este telefono pregunto por la cola. Es el unico modo de
  /// saber desde la aplicacion si sigue vivo: si esta fecha se queda parada,
  /// el telefono esta dormido o apagado y los SMS no salen.
  ultimaConsultaAt DateTime?

  vinculadoPor String   @db.VarChar(150)
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, activo])
  @@map("emisores_sms")
}

/// El buzon PROPIO de una constructora: desde donde sale su correo.
///
/// Sin esta fila, el correo de esa empresa sale por el buzon compartido de la
/// instalacion (`SMTP_*` del entorno). Con ella, sale del suyo: el cliente ve
/// llegar el informe desde la direccion de la constructora y no desde una
/// tecnica que no reconoce, y la respuesta cae donde alguien la lee.
///
/// ES ADEMAS EL UNICO CAMINO PARA LA VERSION INSTALABLE. Cuando GCM se
/// entregue como ejecutable en la maquina del cliente no habra ningun buzon
/// compartido que compartir: o la constructora pone el suyo, o no hay correo.
///
/// UNA POR EMPRESA (`companyId` unico): no es una lista como los emisores de
/// SMS —de los que puede haber varios telefonos— sino la respuesta a «desde
/// donde sale mi correo», que solo admite una.
model RemitenteCorreo {
  id        String @id @default(cuid())
  companyId String @unique

  host   String  @db.VarChar(150)
  puerto Int
  /// TLS directo (465). Falso = STARTTLS (587), que nodemailer negocia solo.
  seguro Boolean @default(true)

  usuario String @db.VarChar(200)

  /**
   * La contrasena, CIFRADA. Ver `src/lib/secreto.ts`.
   * Es el unico secreto de GCM que no se hashea, y no por descuido: hay que
   * presentarsela al servidor SMTP en cada envio, asi que un hash no serviria.
   * La llave de cifrado vive en el entorno, nunca aqui.
   * NUNCA sale hacia la pantalla. La interfaz solo dice si esta puesta.
   */
  claveCifrada String @db.Text

  /// Lo que ve quien recibe: «CONSTRUCTORA X <obras@constructora.pe>». El
  /// correo suele tener que coincidir con `usuario` o el servidor lo rechaza.
  remitenteNombre String @db.VarChar(150)
  remitenteCorreo String @db.VarChar(150)

  /// Apagarlo devuelve la empresa al buzon compartido sin perder lo tecleado.
  activo Boolean @default(true)

  /**
   * Que GCM MIRE este buzon para recoger las respuestas de los contratistas.
   * Apagado por defecto y se enciende a mano: leer el buzon de alguien no se
   * da por supuesto por haber configurado el envio. Son dos permisos morales
   * distintos aunque sea la misma contrasena.
   * Lo que se lee es SOLO lo que responde a un mensaje de GCM —se reconoce por
   * el `Message-ID` que GCM puso al enviar—. El resto del buzon se ignora y no
   * llega nunca a la base: esto no es un cliente de correo.
   * IMAP reutiliza `host`, `usuario` y `claveCifrada` con el puerto 993, que
   * es lo correcto en cPanel y en la mayoria de proveedores. Si alguno lo
   * tiene distinto se anadiran campos propios; hoy seria adivinar cuales.
   */
  leerRespuestas Boolean @default(false)

  /// Hasta donde se leyo la ultima vez que se miro el buzon. Acota el `SEARCH`
  /// de IMAP para no recorrer meses de correo en cada pasada.
  ///
  /// Solo se mueve cuando el buzon se leyo ENTERO y sin fallar, asi que vale
  /// tambien como «ultima lectura correcta» y la pantalla lo usa para eso.
  leidoHastaAt DateTime?

  /**
   * Que fallo la ultima vez que se intento LEER el buzon, y cuando.
   * Va aparte de `ultimoError` —el del envio— porque las dos cosas fallan por
   * causas distintas: el envio muere en el 465 y la lectura en el 993, y una
   * puede llevar semanas rota con la otra perfecta. Con un solo campo, la
   * ultima en fallar borraria la senal de la otra.
   * Existe porque sin el, un buzon que no se puede leer se ve EXACTAMENTE
   * igual que un buzon donde nadie ha contestado: la pasada se apuntaba el
   * fallo en la consola del servidor y seguia, asi que la pantalla decia
   * «recogiendo» para siempre. Es el modo de fallo de la casa —algo deja de
   * contar sin dar error— aplicado a una bandeja de entrada.
   */
  lecturaError   String?   @db.VarChar(300)
  lecturaErrorAt DateTime?

  /// Ultimo envio de prueba que SALIO. Es lo unico que distingue «configurado»
  /// de «configurado y funciona», y sin esa distincion el primer correo que
  /// falla es el que iba al cliente.
  verificadoAt  DateTime?
  /// Que dijo el servidor la ultima vez que fallo, para poder arreglarlo sin
  /// adivinar. Se guarda el mensaje, nunca la contrasena.
  ultimoError   String?   @db.VarChar(300)
  ultimoErrorAt DateTime?

  configuradoPor String   @db.VarChar(150)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("remitentes_correo")
}

/**
 * Un proveedor de IA que una empresa guardo, con su propia clave.
 * A diferencia de `RemitenteCorreo` (una fila por empresa), aqui puede
 * haber VARIAS: cada empresa trae su propio proveedor y su propia clave
 * -en la version instalable no hay ningun servicio de IA que GCM opere-,
 * y puede guardar mas de uno y elegir cual usar. Cual esta EN USO lo dice
 * `Company.proveedorIaActivoId`, no un campo de esta tabla.
 */
model AgenteIaProveedor {
  id        String @id @default(cuid())
  companyId String

  /**
   * STRING, no enum: un proveedor nuevo no debe exigir una migracion,
   * mismo criterio que `CompanyPermission.permiso`. Los que GCM sabe
   * LLAMAR hoy viven en el registro de adaptadores
   * (`src/services/agente-ia.service.ts`); un tipo sin adaptador
   * registrado se puede guardar igual, pero `probarProveedorIa` lo dice
   * en vez de fallar en silencio.
   */
  tipo String @db.VarChar(40)

  /// Nombre visible, SIEMPRE obligatorio: una empresa puede tener dos
  /// proveedores del mismo tipo (dos claves distintas de un mismo
  /// formato) y la lista tiene que poder distinguirlas.
  nombre String @db.VarChar(100)

  /// Solo para adaptadores de URL configurable (p.ej. OpenAI-compatible).
  /// Null en Claude, que usa la URL oficial de Anthropic, fija en su
  /// adaptador.
  urlBase String? @db.VarChar(300)

  modelo String @db.VarChar(100)

  /**
   * La clave de API, CIFRADA. Ver `src/lib/secreto.ts` -mismo cifrado y
   * misma llave que `RemitenteCorreo.claveCifrada`, sin una segunda llave
   * para esto-. Hay que presentarsela al proveedor en cada llamada, asi
   * que un hash no serviria. NUNCA sale hacia la pantalla.
   */
  apiKeyCifrada String @db.Text

  /// Ultima prueba real que SALIO. Igual que en `RemitenteCorreo`:
  /// «configurado» no es lo mismo que «funciona», y activar una clave sin
  /// probar seria descubrir que esta mal el dia que el agente la necesite.
  verificadoAt  DateTime?
  /// Que dijo el proveedor la ultima vez que fallo. Nunca la clave.
  ultimoError   String?   @db.VarChar(300)
  ultimoErrorAt DateTime?

  configuradoPor String   @db.VarChar(150)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company                Company   @relation("ProveedoresDeLaEmpresa", fields: [companyId], references: [id], onDelete: Cascade)
  /// El otro lado del puntero de `Company.proveedorIaActivoId`. Lista y no
  /// un valor unico porque Prisma no puede saber, solo por el esquema, que
  /// nunca habra dos empresas apuntando a la misma fila -eso lo garantiza
  /// que cada empresa solo puede activar SUS propios proveedores, en el
  /// servicio-.
  empresasQueLoActivaron Company[] @relation("ProveedorActivo")

  @@index([companyId])
  @@map("agente_ia_proveedores")
}

enum DireccionSoporte {
  DEL_OPERADOR
  DE_LA_EMPRESA
}

/**
 * Un hilo continuo de mensajes entre el operador de GCM y UNA constructora.
 * Es la primera tabla del sistema que se lee y se escribe legitimamente
 * desde LOS DOS LADOS de la pared operador/empresa: `operador.service.ts`
 * declara que "no entra en los datos de un cliente", y esto es la
 * excepcion deliberada a esa regla -correspondencia, no datos de obra ni
 * de presupuesto-. No es un sistema de tickets con estado
 * (abierto/cerrado/prioridad): un solo hilo por empresa, como el hallazgo
 * que lo pidio.
 */
model MensajeSoporte {
  id String @id @default(cuid())

  /// La empresa CLIENTE, siempre. Nunca la propia del operador -el
  /// operador puede tener su propia cuenta/empresa, pero eso no participa
  /// aqui-.
  companyId String

  direccion DireccionSoporte
  cuerpo    String           @db.Text

  /// Snapshot de quien escribio, igual que `enviadoPor` en
  /// `MensajeContratista`: sobrevive aunque la persona cambie de nombre o
  /// se desactive.
  autorNombre String  @db.VarChar(150)
  /// Sin FK a proposito, mismo criterio que `userId` en
  /// `MensajeContratista`: solo para saber quien si hace falta, no ata la
  /// fila a que el usuario siga existiendo.
  autorUserId String?

  /// Solo tiene sentido cuando `direccion = DE_LA_EMPRESA`: cuando el
  /// OPERADOR lo leyo.
  leidoPorOperadorAt DateTime?
  /**
   * Solo tiene sentido cuando `direccion = DEL_OPERADOR`: cuando alguien
   * de la EMPRESA lo leyo. Es lectura de LADO, no por usuario individual
   * -cualquier administrador de la empresa lo marca leido para todos-,
   * mismo nivel de detalle que ya basta en `MensajeContratista`, que ni
   * siquiera guarda leido/no leido, solo cuenta.
   */
  leidoPorEmpresaAt  DateTime?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("mensajes_soporte")
}

enum RolAgente {
  USUARIO
  ASISTENTE
}

/**
 * Una conversacion con el agente de IA. Una por usuario a la vez, no un
 * archivo navegable de varias -ver el comentario de
 * `agente-conversacion.service.ts` sobre el alcance de esta primera
 * entrega-.
 */
model ConversacionAgente {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  createdAt DateTime @default(now())

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mensajes MensajeAgente[]

  @@index([companyId, userId, createdAt])
  @@map("conversaciones_agente")
}

/**
 * Un mensaje dentro de una conversacion con el agente de IA.
 * El turno del ASISTENTE se crea VACIO y se completa despues -mismo
 * patron de estado por fecha que `MensajeSms`, no un enum de estados-:
 * `terminadoAt: null` es "todavia pensando", y el sondeo del cliente
 * pregunta por esta fila hasta que deje de serlo. Ver
 * `agente-conversacion.service.ts`.
 */
model MensajeAgente {
  id             String    @id @default(cuid())
  conversacionId String
  rol            RolAgente
  /// Vacio mientras el asistente sigue pensando.
  contenido      String    @db.Text
  /// Nombres de las herramientas que se llamaron para responder esta vez,
  /// para poder decir "consultando el semaforo de cartera..." en la
  /// pantalla. Solo tiene sentido en filas ASISTENTE.
  herramientas   Json?
  /// Cuando se creo la fila: para USUARIO es el envio, para ASISTENTE el
  /// instante en que se encolo el turno.
  iniciadoAt     DateTime  @default(now())
  /// Null = todavia procesando. Solo tiene sentido en filas ASISTENTE -las
  /// de USUARIO nacen ya completas-.
  terminadoAt    DateTime?
  /// Por que no se pudo responder, si fallo. Nunca la clave del proveedor.
  error          String?   @db.VarChar(500)
  /// Cuando el asistente, en vez de responder con texto final, PROPONE una
  /// escritura (Fase 2b): guarda {herramienta, datos} -los argumentos
  /// EXACTOS que se ejecutaran si el humano confirma-. Al confirmar se
  /// ejecutan tal cual, sin volver a preguntarle nada al proveedor de IA.
  /// Null en cualquier mensaje que no sea una propuesta.
  propuesta           Json?
  /// Null mientras la propuesta espera el click humano. No-null cuando ya
  /// se resolvio -confirmada, cancelada o expirada-. Mismo patron de
  /// estado por fecha que `terminadoAt`, no un enum.
  propuestaResueltaAt DateTime?
  /// Que paso al resolverse: null si se ejecuto con exito, o el motivo por
  /// el que no -"Cancelada.", "Expiro sin confirmar.", o el error real de
  /// la funcion de servicio al confirmar-.
  propuestaResultado  String?   @db.VarChar(500)

  conversacion ConversacionAgente @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@index([conversacionId, iniciadoAt])
  @@map("mensajes_agente")
}

/// Excepcion al permiso que un rol trae por defecto, para UNA empresa.
///
/// Guarda EXCEPCIONES, no la matriz entera: la ausencia de fila significa
/// "lo que diga la plantilla del rol" en `src/lib/rbac.ts`. De ahi salen dos
/// propiedades que importan. Desplegar esta tabla no cambia el permiso de
/// nadie hasta que alguien edita algo a proposito, y volver a los valores por
/// defecto es BORRAR la fila, no guardar otra: asi la tabla solo contiene
/// desviaciones reales y se puede leer de un vistazo.
///
/// Hay permisos que nunca llegan aqui. `linea_base:aprobar` y
/// `movimiento:aprobar` son actos contractuales irreversibles, y
/// `permiso:leer` y `permiso:editar` reparten los demas. El resolvedor
/// IGNORA cualquier fila que recaiga sobre ellos, aunque se inserte a mano.
model CompanyPermission {
  id        String @id @default(cuid())
  companyId String

  role Role

  /// Nombre tal como aparece en PERMISOS ("obra:editar"). Texto y no enum a
  /// proposito: anadir un permiso al codigo no debe exigir una migracion.
  permiso String @db.VarChar(40)

  /// true concede lo que la plantilla niega; false revoca lo que concede.
  concedido Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, role, permiso])
  @@map("company_permissions")
}

model User {
  id        String @id @default(cuid())
  companyId String

  nombres   String  @db.VarChar(100)
  apellidos String  @db.VarChar(100)
  tipoDoc   String  @db.VarChar(10)
  numDoc    String  @db.VarChar(20)
  cargo     String? @db.VarChar(100)
  celular   String? @db.VarChar(30)
  /// UNICO POR EMPRESA, no en toda la instalacion. Ver `@@unique` al final.
  email     String  @db.VarChar(150)

  /// Foto de perfil, opcional. Se guarda como imagen embebida (data URL) y no
  /// como ruta a un archivo: todavia no hay infraestructura de subida
  /// (`STORAGE_ROOT` esta sin usar), y el avatar ya se recorta y comprime en
  /// el navegador a un tamano pequeno antes de llegar aqui. `MediumText` da de
  /// sobra; el servidor ademas acota el tamano. Es un dato libre, como el
  /// celular: no identifica legalmente a nadie, asi que no pasa por aprobacion.
  fotoPerfil String? @db.MediumText

  passwordHash String @db.VarChar(255)

  /// Rol por defecto a nivel empresa. El rol efectivo en una obra
  /// lo define ProjectMembership y tiene prioridad sobre este.
  role   Role
  estado UserState @default(ACTIVO)

  /// Fuerza el cambio de clave en el primer acceso tras el alta.
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?

  /// Verificacion en dos pasos por codigo. La activa cada persona desde su
  /// perfil; por defecto esta apagada para no dejar fuera a nadie al
  /// desplegar. Un ADMIN puede apagarla si alguien pierde el acceso a su
  /// buzon o a su telefono, que si no seria un callejon sin salida.
  dosFactoresActivo Boolean @default(false)

  /// Por donde quiere recibir el codigo. UNO de los dos, no los dos a la vez:
  /// recibirlo por duplicado en cada entrada molesta y, con SMS, cuesta.
  ///
  /// Es una preferencia, no una garantia: quien manda es `canalEfectivo` en
  /// `@/lib/dosFactores`, que cae al correo si el celular falta o dejo de
  /// estar verificado. El fallo seguro es "te llega por correo", nunca "no te
  /// llega".
  canal2FA Canal2FA @default(CORREO)

  /// Cuando se comprobo que ese celular es de verdad suyo, tecleando un
  /// codigo enviado a el. Null = sin verificar, y entonces el SMS no se puede
  /// elegir como canal.
  ///
  /// Se pone a null en cuanto el numero cambia. Sin eso, cambiar el celular
  /// —que se hace sin aprobacion de nadie— seria una forma de desviarse los
  /// codigos de acceso ajenos desde una sesion secuestrada.
  celularVerificadoAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company             Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  memberships         ProjectMembership[]
  sessions            Session[]
  resetTokens         PasswordResetToken[]
  solicitudesPerfil   SolicitudCambioPerfil[]
  codigosAcceso       CodigoAcceso[]
  suscripcionesAviso  SuscripcionAviso[]
  avisos              Aviso[]
  /// Restricciones del Lookahead de las que se hizo cargo. Lleva nombre de
  /// relacion porque el dia que haya un segundo vinculo entre las dos tablas
  /// —quien la resolvio, por ejemplo— Prisma no sabria cual es cual.
  restriccionesACargo Restriccion[]           @relation("RestriccionesResponsable")
  hitosACargo         HitoObra[]              @relation("HitosResponsable")
  /// Analisis de causa raiz de los que se hizo cargo. Mismo motivo que arriba
  /// para llevar nombre de relacion.
  analisisACargo      AnalisisCausa[]         @relation("AnalisisResponsable")

  /**
   * EL CORREO ES UNICO POR EMPRESA, no en toda la instalacion.
   * Lo era globalmente hasta el 20/08/2026, y no por descuido: el login
   * identificaba a la persona SOLO por su correo. Se cambio por decision del
   * usuario —«que las cuentas sean independientes para cada constructora,
   * porque son dueños diferentes»—: la misma persona puede trabajar para dos
   * clientes de GCM, y un supervisor externo para varios.
   * LO QUE HAY QUE SABER: el login ya no puede resolver a quien pertenece un
   * correo mirando esta tabla. Prueba la clave contra las cuentas que lo
   * compartan y, si casan varias, pregunta en cual entrar. Ver
   * `auth.service.iniciarSesion`.
   */
  @@unique([companyId, email])
  @@unique([companyId, numDoc])
  @@index([companyId, estado])
  /// Para buscar los candidatos del login, que ya no van por clave unica.
  @@index([email])
  @@map("users")
}

/// Solicitud de cambio de datos de identidad del propio perfil.
///
/// El celular se cambia directo, pero nombres, apellidos, cargo y documento NO:
/// son exactamente lo que queda escrito en los `aprobadaPor` de ordenes y
/// movimientos ya emitidos, y el documento identifica a la persona. De ahi
/// que se soliciten y los apruebe un ADMIN.
///
/// Cada campo es nullable: NULL significa «este campo no se cambia». Solo
/// viajan los que de verdad difieren de lo que hay.
model SolicitudCambioPerfil {
  id        String @id @default(cuid())
  companyId String
  userId    String

  /// Lo propuesto. NULL = ese campo no se cambia.
  nombres   String? @db.VarChar(100)
  apellidos String? @db.VarChar(100)
  cargo     String? @db.VarChar(100)
  tipoDoc   String? @db.VarChar(10)
  numDoc    String? @db.VarChar(20)

  motivo String? @db.Text

  estado        EstadoSolicitud @default(PENDIENTE)
  resueltaAt    DateTime?
  resueltaPor   String?         @db.VarChar(150)
  motivoRechazo String?         @db.Text

  /// Vale `userId` mientras esta PENDIENTE y NULL en cuanto se resuelve.
  /// Es lo que garantiza EN LA BASE «una sola pendiente por usuario»: MySQL
  /// admite varios NULL en una columna unica, asi que las resueltas no chocan
  /// entre si. Un indice unico parcial no existe en MySQL.
  usuarioPendienteId String? @unique

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, estado])
  @@map("solicitudes_cambio_perfil")
}

// ---------------------------------------------------------------------------
// Sesiones y recuperacion de clave
//
// Se usan tokens opacos aleatorios, no JWT: permiten revocar el acceso al
// instante borrando la fila. En la base solo vive el hash del token, nunca
// el token en claro, de modo que un volcado de la base no permite suplantar.
// ---------------------------------------------------------------------------

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Por donde sale el codigo de acceso.
///
/// Correo y SMS, uno u otro. No hay "los dos": recibir el mismo codigo por
/// duplicado en cada entrada molesta, y por SMS ademas cuesta dinero de la
/// linea de la empresa.
enum Canal2FA {
  CORREO
  SMS
}

/// Para que se pidio un codigo.
///
/// `ACCESO` es el segundo paso del ingreso; `VERIFICAR_CELULAR` comprueba que
/// un numero es de quien dice antes de dejarle elegirlo como canal. Van en la
/// misma tabla porque son el mismo mecanismo —seis cifras, caducidad, tope de
/// intentos—, pero NO se pueden mezclar: cada ciclo borra y gasta solo los
/// suyos.
enum PropositoCodigo {
  ACCESO
  VERIFICAR_CELULAR
}

/// Codigo de un solo uso para la verificacion en dos pasos.
///
/// Existe entre que alguien acierta su clave y termina de entrar. Guarda DOS
/// secretos distintos y por eso hay dos hashes:
///
/// - `tokenHash` identifica el desafio. Su token viaja en una cookie, de modo
///   que el navegador no puede decir "soy el usuario X": solo presenta un
///   vale opaco que el servidor resuelve. Es NULO cuando el proposito es
///   `VERIFICAR_CELULAR`: ahi la persona ya tiene sesion, asi que el desafio
///   se ata a su `userId` y no hace falta cookie ni vale opaco.
/// - `codigoHash` es el codigo de seis cifras que llega al correo o al SMS,
///   que es lo unico que demuestra el acceso a ese buzon o a ese telefono.
///
/// Sin el token, el usuario tendria que reenviar su correo junto al codigo y
/// bastaria con adivinar seis cifras de CUALQUIER cuenta; con el, un intento
/// solo vale contra el desafio que uno mismo abrio.
model CodigoAcceso {
  id     String @id @default(cuid())
  userId String

  /// Para que se pidio: entrar, o comprobar que un celular es de quien dice.
  /// Separa los dos ciclos, que conviven: se puede estar verificando el
  /// telefono en el perfil y a la vez tener un desafio de acceso abierto en
  /// otra pestana, y uno no puede gastar ni borrar el del otro.
  proposito PropositoCodigo @default(ACCESO)

  /// A donde se mando, ya normalizado. Sirve para dos cosas: ensenarlo tapado
  /// en la pantalla ("te lo mandamos al 999321") aunque se recargue, y que un
  /// codigo pedido para un numero no sirva para verificar otro si la persona
  /// lo cambia entre medias.
  destino String? @db.VarChar(150)

  tokenHash  String? @unique @db.Char(64)
  codigoHash String  @db.Char(64)

  /// Intentos gastados. Al llegar al tope el desafio se borra y toca volver a
  /// empezar por la clave: sin esto, seis cifras se agotan a fuerza bruta.
  intentos Int @default(0)

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("codigos_acceso")
}

// ---------------------------------------------------------------------------
// Obras y equipo asignado
// ---------------------------------------------------------------------------

model Project {
  id        String @id @default(cuid())
  companyId String

  nombreObra String  @db.VarChar(255)
  codigoObra String? @db.VarChar(40)

  /// Correlativo interno que asigna el SISTEMA, ascendente por empresa
  /// ("OB-000001"). Distinto de `codigoObra`, que lo pone la persona y puede
  /// faltar o repetir formato entre obras. Este es unico, no se recicla y
  /// sirve para buscar y para auditoria. Nullable solo por las obras que
  /// existian antes de introducirlo; las nuevas siempre lo llevan.
  correlativo String? @db.VarChar(20)

  ubicacion String? @db.VarChar(255)

  /// Si los gastos generales de la meta cuentan en la BOLSA OPERATIVA.
  ///
  /// Por defecto true, que es como se venia calculando: cambiar el default
  /// movería la bolsa de todas las obras existentes sin que nadie lo pidiera,
  /// y este proyecto ya sabe lo que cuesta una cifra que cambia sola.
  ///
  /// Es de PRESENTACION, no de datos: los gastos generales se siguen cargando
  /// y guardando siempre. Apagarlo solo los saca del calculo de la bolsa, y
  /// por eso se puede cambiar EN CUALQUIER MOMENTO —incluso con metas ya
  /// aprobadas y congeladas— sin migrar nada ni tocar el historico.
  ///
  /// Existe porque en la practica del usuario los gastos generales (y la
  /// utilidad) NO son del presupuesto que gestiona la obra: solo se tocan si
  /// el gerente general autoriza pasar dinero de ahi para cubrir un
  /// comprometido cuando la bolsa ya se agoto.
  /// null = TODAVIA NO SE HA DECIDIDO. No lleva default a proposito: es una
  /// decision que hay que tomar, no un valor que se hereda sin mirarlo. La
  /// obra no deja avanzar mientras siga en null y ya haya presupuesto
  /// contractual cargado, que es el momento en que la pregunta tiene sentido
  /// (antes no se sabe contra que se compara).
  metaIncluyeGastosGenerales Boolean?
  cliente                    String?  @db.VarChar(200)
  descripcion                String?  @db.Text

  fechaInicio        DateTime @db.Date
  fechaFinProgramada DateTime @db.Date

  estado ProjectState @default(PLANIFICACION)

  /// Por que se paralizo, tecleado al pasar a PARALIZADA. Se limpia a null al
  /// salir de PARALIZADA (reanudar o cerrar) — igual que
  /// `PaseObra.revocadoAt/revocadoPor` se limpian al reactivar un pase. Una
  /// obra paralizada ANTES de que existiera este campo se queda con null: no
  /// se fuerza a completarlo con caracter retroactivo.
  motivoParalizacion String? @db.VarChar(300)

  /// Cuando se espera reanudar. Opcional a proposito: a veces de verdad no se
  /// sabe (litigio, financiamiento pendiente), y obligarla invitaria a
  /// teclear cualquier fecha solo para pasar el formulario.
  fechaEstimadaReanudacion DateTime? @db.Date

  /// Cuando se paralizo. Lo pone `cambiarEstadoObra`, no el usuario — marca de
  /// cuando, como `archivadaEn`/`aprobadaAt` en el resto del esquema.
  paralizadaEn DateTime?

  /// Dia de la semana en que se espera el corte de avance (cadencia semanal,
  /// Last Planner). ISO: 1=lunes … 7=domingo. Viernes por defecto.
  diaCorteSemanal Int @default(5)

  /// El ultimo `uid` que se ha entregado a una tarea tecleada a mano. Va en
  /// NEGATIVO y solo baja: 0, -1, -2…
  ///
  /// Existe porque el uid es el ancla contra la que se guardan `AvanceTarea` y
  /// `MapeoTareaPartida`, y esas dos anclan a `(projectId, uid)` **sin clave
  /// foranea**. Si al borrar una tarea manual su uid volviera al saco, la
  /// siguiente tarea lo heredaria junto con el avance de la muerta, y el aviso
  /// de huerfanos se apagaria justo en ese momento —porque el uid vuelve a
  /// existir—: el dato se corrompe y la alarma se calla a la vez.
  ///
  /// Vive en la OBRA y no en el cronograma porque las versiones se sustituyen
  /// y el ancla tiene que sobrevivir a eso.
  ultimoUidManual Int @default(0)

  /// Con fecha = esta obra NO es una obra: es una COPIA restaurada de un
  /// respaldo, cargada para revisarla. Nace y muere en modo auditoria y no
  /// admite un solo cambio.
  ///
  /// Se guarda la fecha y no un booleano por el idioma de la casa
  /// (`purgadaAt`, `aprobadaAt`, `cerradoAt`): un `true` dice que paso, una
  /// fecha dice ademas cuando, y eso es justo lo que se pregunta de una copia
  /// de auditoria.
  ///
  /// La restauracion la crea ademas en estado CERRADA, asi que la guarda de
  /// escritura que ya existe la cubre desde el primer momento. Esta columna es
  /// la segunda vuelta de llave: si algun dia se relajara la regla de CERRADA,
  /// una copia de auditoria seguiria congelada.
  archivadaEn DateTime?

  /// De donde salio la copia: id original, correlativo, fecha del respaldo,
  /// quien lo genero y version del formato. Es lo que se enseña en el cartel
  /// de auditoria, y lo unico que ata la copia con la obra que ya no existe.
  respaldoOrigen Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company              Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  memberships          ProjectMembership[]
  wbsItems             WbsItem[]
  baselines            Baseline[]
  movimientos          MovimientoPresupuestal[]
  ordenes              OrdenCompra[]
  cronogramas          Cronograma[]
  avances              AvanceTarea[]
  mapeos               MapeoTareaPartida[]
  hitos                HitoObra[]
  encargos             EncargoProveedor[]
  planesSemanales      PlanSemanal[]
  calendariosLaborales WorkCalendar[]
  lookaheadTareas      LookaheadTask[]
  fotosEvidencia       FotoEvidencia[]
  fotosGaleria         FotoGaleria[]
  galeriaObra          GaleriaObra?
  pasesObra            PaseObra[]
  analisisCausa        AnalisisCausa[]
  contactosAviso       ContactoAviso[]
  suscripcionesAviso   SuscripcionAviso[]
  avisos               Aviso[]
  ajustesAvisos        AjustesAvisosObra?
  presupuestosMeta     PresupuestoMeta[]
  valorizaciones       ValorizacionEncargo[]
  notas                Nota[]
  adjuntosNota         AdjuntoNota[]

  @@unique([companyId, codigoObra])
  @@unique([companyId, correlativo])
  @@index([companyId, estado])
  @@map("projects")
}

/// Asigna un usuario a una obra con un rol especifico.
/// Un mismo usuario puede ser RESIDENTE en una obra y CONSULTOR en otra.
model ProjectMembership {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      Role
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@map("project_memberships")
}

// ---------------------------------------------------------------------------
// EDT / Presupuesto por partidas
//
// Aqui se cierra la brecha detectada en el proceso actual: hoy los metrados
// viven como texto libre dentro del nombre de la partida
// ("Excavacion para zapatas (4.25 m3)"). Al volverlos campos propios se
// habilita todo el control economico posterior.
// ---------------------------------------------------------------------------

model WbsItem {
  id        String  @id @default(cuid())
  projectId String
  parentId  String?

  /// Movimiento que dio de alta esta partida, si nacio de un adicional y no
  /// del presupuesto original. Sirve para dos cosas: distinguir en pantalla
  /// lo contratado de lo anadido despues, y saber que su presupuesto BASE es
  /// cero (no figura en la linea base) aunque tenga vigente.
  origenMovimientoId String?

  /// Codigo jerarquico. "2.0" = capitulo, "2.1" = partida.
  /// VarChar(32) admite tambien el formato S10 peruano ("01.01.02").
  codigoPartida String  @db.VarChar(32)
  tipo          WbsType
  descripcion   String  @db.VarChar(500)

  /// Como se contrato la partida. Gobierna si el importe se recalcula al
  /// cambiar el metrado y como se valorizara su avance.
  modalidad ModalidadPartida @default(PRECIOS_UNITARIOS)

  /// Profundidad en el arbol (0 = raiz). Evita recursion para ordenar y mostrar.
  nivel Int @default(0)
  orden Int @default(0)

  /// Por donde entro la partida, y si alguien la ha tocado despues.
  ///
  /// Existen para una sola pregunta, la que se hace al reimportar un Excel
  /// corregido: de lo que voy a borrar, ¿que NO esta en ningun archivo?
  ///
  /// Una partida importada se puede perder sin drama, porque el Excel la
  /// vuelve a traer. Una creada a mano, o una importada cuyo precio alguien
  /// corrigio despues, no existe en ninguna otra parte: borrarla destruye
  /// trabajo. Sin estos dos campos, el aviso de reemplazo solo puede decir
  /// "se borraran 360 partidas", que se lee como rutina.
  origen       OrigenRegistro @default(MANUAL)
  editadaAMano Boolean        @default(false)

  // --- Datos de presupuesto. Solo aplican a tipo = PARTIDA ---
  unidad         String?  @db.VarChar(20)
  metrado        Decimal? @db.Decimal(14, 4)
  precioUnitario Decimal? @db.Decimal(14, 4)
  /// Derivado: metrado * precioUnitario. Se persiste para evitar recalcular
  /// el arbol completo en cada consulta de tablero.
  parcial        Decimal? @db.Decimal(14, 2)

  /// Fecha opcional que trajo el presupuesto (plantilla meta o contractual),
  /// no una fecha real de ejecucion -este modelo no tiene ninguna-. Solo
  /// aplica a las HOJAS (aportantes): "generarEdtDesdePresupuesto" las usa
  /// para programar la tarea de una vez en vez de dejarla `sinProgramar`.
  /// Las dos van juntas: una partida no puede traer una sin la otra.
  fechaInicioPlan DateTime? @db.Date
  fechaFinPlan    DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   WbsItem?  @relation("WbsTree", fields: [parentId], references: [id], onDelete: Restrict)
  children WbsItem[] @relation("WbsTree")

  /// Cascade y no SetNull: si se elimina el borrador de un adicional, las
  /// partidas que propuso deben irse con el. Con SetNull sobrevivirian sin
  /// importe y sin marca de origen, imposibles de borrar despues porque la
  /// linea base congelada bloquea el borrado de partidas, y ocupando su
  /// codigo para siempre.
  origenMovimiento MovimientoPresupuestal? @relation("PartidasDeAdicional", fields: [origenMovimientoId], references: [id], onDelete: Cascade)

  lineasMovimiento MovimientoLinea[]
  imputaciones     OrdenImputacion[]
  proveedores      ProveedorPartida[]
  encargos         EncargoPartida[]
  repartosMeta     MetaItemPartida[]

  @@unique([projectId, codigoPartida])
  @@index([projectId, parentId])
  @@index([projectId, orden])
  @@index([origenMovimientoId])
  @@index([projectId, tipo])
  @@index([projectId, modalidad])
  @@index([parentId, orden])
  @@map("wbs_items")
}

// ---------------------------------------------------------------------------
// Linea base del presupuesto (presupuesto congelado)
//
// Vive aparte de WbsItem a proposito. Si la linea base se pudiera editar,
// los indicadores de avance y costo se recalcularian hacia atras y el
// sistema mentiria. Una vez aprobada, es inmutable.
// ---------------------------------------------------------------------------

model Baseline {
  id        String @id @default(cuid())
  projectId String

  version       Int
  /// Fecha de la revision, la que aparece en el resumen del presupuesto.
  /// No coincide con createdAt: una revision del 03/06 puede cargarse despues.
  fechaRevision DateTime @db.Date
  notas         String?  @db.Text

  // --- Cascada del presupuesto -------------------------------------------
  //
  // El presupuesto no es la suma de partidas. Sobre el costo directo se
  // aplican descuentos comerciales, gastos generales y utilidad. Los
  // porcentajes viven aqui y no como partidas porque cambian entre
  // revisiones, y cada revision debe conservar los suyos: si se guardaran
  // en la obra, recalcular una revision antigua daria otro numero y la
  // comparacion entre revisiones dejaria de tener sentido.

  /// Suma de las partidas, antes de cualquier ajuste.
  costoDirecto Decimal @db.Decimal(14, 2)
  /// Descuentos comerciales, negativos.
  descuentos   Decimal @default(0) @db.Decimal(14, 2)

  porcentajeGastosGenerales Decimal @default(0) @db.Decimal(6, 4)
  porcentajeUtilidad        Decimal @default(0) @db.Decimal(6, 4)
  porcentajeIgv             Decimal @default(0.18) @db.Decimal(6, 4)

  /// Descuento comercial como PORCENTAJE, para la cascada 2.
  ///
  /// Convive con `descuentos` (un monto) porque la cascada 1 lo usaba asi y
  /// las revisiones ya congeladas guardan aquel valor. Cada version usa el
  /// suyo; no se convierte uno en otro.
  porcentajeDescuento Decimal @default(0) @db.Decimal(6, 4)

  /// Como tributa el presupuesto que se entrega al cliente.
  ///
  /// Se reutiliza el mismo enum que las ordenes de compra a proposito: es el
  /// mismo hecho tributario visto desde el otro lado, y tener dos
  /// vocabularios para lo mismo es como acaban divergiendo.
  ///
  /// - IGV:     constructora que factura. Se desglosa el 18%.
  /// - RENTA:   emite recibo por honorarios. Sin IGV, con retencion de 4ta.
  /// - NINGUNO: sin impuesto en el documento.
  tipoImpuesto TipoImpuesto @default(IGV)

  /// Tasa de la retencion de cuarta categoria. Solo cuenta con RENTA.
  porcentajeRetencion Decimal @default(0.08) @db.Decimal(6, 4)

  /// Si la constructora ASUME la retencion subiendo el precio.
  ///
  /// false: el precio pactado no cambia y se ensena cuanto queda limpio.
  /// true:  el precio se infla para que, tras retener, quede lo pactado. Es
  ///        lo mismo que ya hacen las ordenes con TipoImpuesto.RENTA.
  retencionAsumida Boolean @default(false)

  /// Que cascada calculo esta revision. NO se toca al reeditar.
  ///
  /// 1: costo directo + descuentos, y sobre eso gastos generales y utilidad.
  /// 2: gastos generales y utilidad sobre el costo directo, y el descuento
  ///    despues. Es la que se acordo el 20/08.
  ///
  /// Existe para que las revisiones firmadas con la cascada 1 sigan dando su
  /// total guardado. Cambiarles el orden las haria contradecirse solas, sin
  /// dar ningun error.
  versionCascada Int @default(1)

  /// Presupuesto de la revision, sin IGV: es la cifra de control.
  /// costoDirecto + descuentos, mas gastos generales y utilidad.
  montoTotal Decimal @db.Decimal(14, 2)

  /// Tipo de cambio del dia, para expresar el presupuesto en dolares.
  tipoCambio Decimal? @db.Decimal(8, 4)

  /// Clausulas de ejecucion: alcance, forma de pago, garantia, vigencia.
  /// Son las condiciones comerciales de ESTA revision y cambian entre una
  /// y otra, asi que se guardan con ella y no con la obra. La clausula de
  /// alcance define cuando procede un adicional frente a una reconversion.
  clausulas String? @db.Text

  /// null = borrador editable. Con fecha = CONGELADA e inmutable.
  aprobadaAt  DateTime?
  aprobadaPor String?   @db.VarChar(150)

  createdAt DateTime @default(now())

  project     Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items       BaselineItem[]
  movimientos MovimientoPresupuestal[]

  @@unique([projectId, version])
  @@map("baselines")
}

/// Copia inmutable de la partida en el momento de congelar.
/// Duplica los datos a proposito: no hay relacion con WbsItem porque la
/// linea base debe sobrevivir intacta aunque despues se renombren o
/// eliminen partidas del presupuesto vivo.
model BaselineItem {
  id         String @id @default(cuid())
  baselineId String

  codigoPartida  String           @db.VarChar(32)
  descripcion    String           @db.VarChar(500)
  tipo           WbsType
  modalidad      ModalidadPartida @default(PRECIOS_UNITARIOS)
  nivel          Int              @default(0)
  orden          Int              @default(0)
  unidad         String?          @db.VarChar(20)
  metrado        Decimal?         @db.Decimal(14, 4)
  precioUnitario Decimal?         @db.Decimal(14, 4)
  parcial        Decimal?         @db.Decimal(14, 2)

  baseline Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  @@index([baselineId, orden])
  @@map("baseline_items")
}

// ---------------------------------------------------------------------------
// Movimientos presupuestales
//
// Van ENCIMA de la linea base, que nunca se toca. De ahi salen las tres
// cifras que maneja el control de obra:
//
//   BASE     lo que dice la copia congelada (baseline_items)
//   AJUSTES  la suma de las lineas de movimientos APROBADOS
//   VIGENTE  base + ajustes
//
// El vigente NO se recalcula con `sumarHojas`. Esa funcion decide que nodo
// cuenta segun el signo de su importe: un adicional que cruce a positivo una
// hoja hoy negativa la haria "cubrir" a su ancestro y borraria el importe del
// ancestro sin error ni rastro. Se ejecuta una sola vez, sobre la linea base,
// y los ajustes se suman planos encima.
// ---------------------------------------------------------------------------

/// Naturaleza contractual del movimiento. Gobierna como deben componerse sus
/// lineas y si puede dar de alta partidas nuevas.
enum TipoMovimiento {
  /// Saca de una partida y mete en otra. La suma de sus lineas es CERO.
  RECONVERSION
  /// Aumenta el presupuesto aprobado. Solo entradas. La clausula 1 del
  /// contrato define cuando procede: vicios ocultos o cambios de diseno.
  ADICIONAL
  /// Reduce el presupuesto aprobado. Solo salidas.
  DEDUCTIVO
}

enum EstadoMovimiento {
  BORRADOR
  APROBADO
}

/// Las ordenes reales del cliente se titulan todas "ORDEN DE SERVICIO",
/// incluso las que suministran equipos. El titulo del papel no distingue
/// nada, asi que el tipo se guarda aparte.
enum TipoOrden {
  COMPRA
  SERVICIO
}

/// Por donde entro el dato al sistema.
///
/// El formulario SIEMPRE tiene que estar disponible: la carga de archivo es
/// un acelerador, no el unico camino. Si el archivo del proveedor viene raro,
/// o simplemente no existe, la orden se teclea y punto.
///
/// Que las dos vias no se pisen NO se confia a la interfaz, se cierra en la
/// base con `@@unique([companyId, numero])`. Da igual por donde entre: el
/// numero de orden identifica el documento y no puede repetirse. El
/// importador topa con la misma restriccion que el formulario, y por eso
/// tiene que ENSENAR lo que ya existe en vez de insertarlo otra vez.
enum OrigenRegistro {
  MANUAL
  IMPORTADO
}

enum TipoCuenta {
  AHORROS
  CORRIENTE
}

/// Moneda de la cuenta. Las ordenes del cliente dicen "Cta. BCP Soles", y hay
/// proveedores que facturan en dolares: pagar a la cuenta equivocada es un
/// error caro de deshacer.
enum MonedaCuenta {
  PEN
  USD
}

/// Que impuesto lleva una orden, y con el, contra que cifra cuenta.
///
/// Sale de las ordenes reales, que traen los tres casos:
///
/// - IGV: el proveedor factura y el impuesto es CREDITO FISCAL. Se recupera,
///   asi que el costo de obra es el NETO. Es el caso corriente.
/// - RENTA: retencion de cuarta categoria, cuando el proveedor emite recibo
///   por honorarios. NO se recupera: es dinero que sale y no vuelve, asi que
///   el costo de obra es el TOTAL. La empresa la asume encima del neto, de
///   modo que al proveedor le quede limpio lo pactado (OC 00115 y 00119).
/// - NINGUNO: sin impuesto en el documento. El total iguala al neto
///   (OC 00114, cuya casilla de IR viene vacia).
///
/// Confundir los dos primeros deja fuera del costo un 8 % que si se paga.
enum TipoImpuesto {
  IGV
  RENTA
  NINGUNO
}

enum EstadoOrden {
  BORRADOR
  APROBADA
  /// Anulada NO es borrada: deja de contar en el comprometido pero se
  /// conserva con su motivo. Cancelar un pedido a un proveedor es corriente,
  /// al reves que rehacer una linea base.
  ANULADA
}

model MovimientoPresupuestal {
  id        String @id @default(cuid())
  projectId String

  /// Linea base que ajusta. No es decorativo: de ella se heredan los
  /// porcentajes de gastos generales y utilidad, que son terminos del
  /// contrato y no se renegocian por un adicional.
  baselineId String

  /// Correlativo por obra, para poder citarlo en un acta: "Movimiento 003".
  numero Int
  tipo   TipoMovimiento
  estado EstadoMovimiento @default(BORRADOR)

  /// Fecha del documento que lo respalda, no la del alta en el sistema.
  fecha DateTime @db.Date

  concepto   String  @db.VarChar(300)
  /// Por que procede. En un ADICIONAL es donde se invoca la clausula 1.
  motivo     String  @db.Text
  /// Carta, acta o correo del cliente que lo autoriza.
  referencia String? @db.VarChar(120)

  /// Totales derivados de las lineas. Se persisten para poder listar sin
  /// agregar, igual que `WbsItem.parcial`, pero no se confia en ellos: se
  /// recalculan desde las lineas dentro de la transaccion de aprobacion.
  totalEntradas Decimal @default(0) @db.Decimal(14, 2)
  totalSalidas  Decimal @default(0) @db.Decimal(14, 2)
  importeNeto   Decimal @default(0) @db.Decimal(14, 2)

  /// Aprobar es irreversible, como aprobar una revision. Un movimiento
  /// aprobado se corrige con otro de signo contrario, no borrandolo.
  aprobadoAt  DateTime?
  aprobadoPor String?   @db.VarChar(150)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Cascade, y no Restrict como parecia prudente al principio.
  ///
  /// Con Restrict, borrar la OBRA falla: su cascada llega a `baselines`
  /// antes que a `movimientos_presupuestales` y choca contra la propia
  /// restriccion. Comprobado, no supuesto. Restrict aqui no protege el
  /// dinero: solo rompe el borrado de obras.
  ///
  /// La proteccion que se buscaba va donde si puede aplicarse: cuando exista
  /// un borrado de revisiones, debe rechazar en el servicio las lineas base
  /// que tengan movimientos encima. Hoy no hay ningun camino que borre una
  /// `Baseline` suelta.
  baseline Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  lineas          MovimientoLinea[]
  partidasCreadas WbsItem[]         @relation("PartidasDeAdicional")

  @@unique([projectId, numero])
  @@index([projectId, estado])
  @@index([baselineId, estado])
  @@index([projectId, fecha])
  @@index([tipo, estado])
  @@index([aprobadoAt])
  @@map("movimientos_presupuestales")
}

model MovimientoLinea {
  id           String @id @default(cuid())
  movimientoId String

  /// Partida afectada. Nula solo mientras el movimiento es BORRADOR y la
  /// linea propone una partida nueva: esa se crea al APROBAR, no antes, para
  /// que un borrador descartado no deje partidas fantasma en el arbol.
  wbsItemId String?

  /// Copia del codigo en el momento del movimiento, para que el documento
  /// siga siendo legible aunque despues se renombre la partida.
  codigoPartida String? @db.VarChar(32)

  /// Positivo entra, negativo sale. Nunca cero.
  importe Decimal @db.Decimal(14, 2)

  /// Modalidad de la partida afectada, copiada al registrar. No se puede
  /// sacar dinero por reconversion de una partida a SUMA_ALZADA: su precio
  /// esta cerrado y el resultado no seria facturable.
  modalidad ModalidadPartida?

  justificacion String? @db.VarChar(300)

  // --- Solo cuando la linea da de alta una partida nueva ---------------
  nuevoCodigo      String?  @db.VarChar(32)
  nuevaDescripcion String?  @db.VarChar(500)
  nuevaUnidad      String?  @db.VarChar(20)
  nuevoMetrado     Decimal? @db.Decimal(14, 4)
  nuevoPrecio      Decimal? @db.Decimal(14, 4)
  /// Capitulo del que colgara. Debe ser un CAPITULO y no una PARTIDA: si
  /// colgara de una partida con importe propio, `sumarHojas` dejaria de
  /// contar a esa partida y su importe desapareceria del presupuesto.
  nuevoParentId    String?

  createdAt DateTime @default(now())

  movimiento MovimientoPresupuestal @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  /// Restrict: una linea aprobada es dinero. Si alguna vez se habilita el
  /// borrado de partidas, que choque aqui en vez de mover el vigente en
  /// silencio.
  partida    WbsItem?               @relation(fields: [wbsItemId], references: [id], onDelete: Restrict)

  @@index([movimientoId])
  @@index([wbsItemId])
  @@map("movimiento_lineas")
}

// ---------------------------------------------------------------------------
// Proveedores y ordenes
//
// De aqui sale el COMPROMETIDO, la primera columna del control de obra: lo
// que ya se pactó con proveedores aunque todavia no se haya recibido ni
// pagado. Se mide contra el IMPORTE IMPUTABLE de cada orden: el neto en las
// que llevan IGV —que es credito fiscal y no costo—, y el total en las de
// retencion de renta o sin impuesto, donde no hay nada que recuperar.
// ---------------------------------------------------------------------------

model Proveedor {
  id        String @id @default(cuid())
  companyId String

  razonSocial String @db.VarChar(200)

  /// Puede ser persona natural: en las ordenes reales hay RUC que empiezan
  /// por 10 (CABREJO, 10061662257) junto a empresas que empiezan por 20.
  ruc String @db.VarChar(11)

  contactoNombre   String? @db.VarChar(150)
  contactoTelefono String? @db.VarChar(30)
  email            String? @db.VarChar(150)

  /// Los datos bancarios viven en el proveedor y no en cada orden, aunque el
  /// papel los repita en todas: son del proveedor, no del pedido.
  ///
  /// El numero de cuenta SOLO no sirve para pagar: hace falta saber a que
  /// banco es y de que tipo. Las ordenes del cliente lo escriben todo junto
  /// ("Cta. BCP Soles: 194 2629150 0 70") y aqui va en campos aparte, para
  /// que se pueda listar por banco y para no depender de como lo tecleo cada
  /// quien.
  banco          String?       @db.VarChar(80)
  tipoCuenta     TipoCuenta?
  monedaCuenta   MonedaCuenta?
  cuentaBancaria String?       @db.VarChar(40)

  /// La interbancaria no necesita banco: lo lleva codificado en sus primeros
  /// digitos. Es la que sirve para transferir desde otra entidad.
  cci String? @db.VarChar(40)

  /**
   * La cuenta de detraccion del Banco de la Nacion.
   * Va con las demas cuentas por el mismo motivo que ellas: es del proveedor y
   * no del pedido. Y va APARTE de `cuentaBancaria` porque no es la misma
   * cuenta ni sirve para lo mismo: a esta se deposita el porcentaje detraido, y
   * pagar el total a la cuenta corriente cuando habia detraccion es un problema
   * tributario, no un descuido de tesoreria.
   */
  cuentaDetraccion String? @db.VarChar(40)

  /// Vende, ejecuta, o las dos cosas. Solo sirve para poder distinguirlos en la
  /// lista: la ficha, el RUC y las cuentas son las mismas.
  rol RolProveedor @default(PROVEEDOR)

  /// Que impuesto lleva lo que emite este proveedor.
  ///
  /// Va aqui y no en cada orden porque es una propiedad SUYA y no del pedido:
  /// quien factura, factura siempre, y quien emite recibo por honorarios lo
  /// emite siempre. Cada orden lo hereda ya puesto y solo se toca por
  /// excepcion. Sin esto habria que acertarlo a mano en cada orden, y
  /// equivocarse deja fuera del costo un 8 % que si se paga.
  ///
  /// NO se deduce del RUC: CABREJO empieza por 10, como persona natural, y
  /// aun asi factura con IGV.
  tipoImpuesto TipoImpuesto @default(IGV)

  activo Boolean @default(true)

  /// Igual que en las ordenes: el RUC es la clave que impide duplicarlo,
  /// entre por donde entre.
  origen OrigenRegistro @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  ordenes         OrdenCompra[]
  habituales      ProveedorPartida[]
  encargos        EncargoProveedor[]
  lookaheadTareas LookaheadTask[]
  compromisos     CompromisoSemanal[]
  mensajes        MensajeContratista[]

  @@unique([companyId, ruc])
  @@index([companyId])
  @@index([companyId, razonSocial])
  @@index([companyId, activo])
  @@index([companyId, rol])
  @@map("proveedores")
}

/// Partidas de las que un proveedor se hace cargo habitualmente en UNA obra.
///
/// Es por obra y no por empresa porque una partida no es una idea abstracta:
/// `11.02.04` es una fila del presupuesto de CRIOCORD, y en la siguiente obra
/// sera otra, quiza con otro codigo. Ademas es lo que refleja la realidad, que
/// un mismo proveedor puede hacer vidrios en una obra y mamparas en otra.
///
/// NO limita nada: al redactar una orden estas salen primero, pero se puede
/// imputar a cualquier partida de la obra. Solo evita buscar entre 314 cada
/// vez.
///
/// Se configura USANDOLAS: al guardar una orden se ofrece recordar sus
/// partidas para ese proveedor. Una pantalla de configuracion aparte seria
/// una que nadie visitaria.
model ProveedorPartida {
  id          String @id @default(cuid())
  proveedorId String
  /// La obra sale de la partida: `WbsItem` ya sabe a que proyecto pertenece.
  wbsItemId   String

  createdAt DateTime @default(now())

  proveedor Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  partida   WbsItem   @relation(fields: [wbsItemId], references: [id], onDelete: Cascade)

  @@unique([proveedorId, wbsItemId])
  @@index([wbsItemId])
  @@map("proveedor_partidas")
}

/// Forma de pago reutilizable.
///
/// Las de las ordenes reales se repiten con pocas variantes —"50% adelanto,
/// 40% contra instalacion, 10% contra dossier"— y volver a teclearlas invita
/// a que cada una acabe diciendo algo distinto de lo pactado.
///
/// Es una PLANTILLA de texto, no un calendario de anticipos. Lo que se guarda
/// en la orden sigue siendo el texto, copiado y editable: modelar los tramos
/// sin haber visto como se pagan de verdad seria inventarlo, y eso llegara
/// con el modulo de abonos.
model FormaPagoPlantilla {
  id        String @id @default(cuid())
  companyId String

  /// Como se elige en el desplegable: "50/40/10 con dossier".
  nombre String @db.VarChar(100)
  /// Lo que se copia a la orden.
  texto  String @db.Text

  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, nombre])
  @@index([companyId])
  @@map("formas_pago_plantillas")
}

/// Un mensaje reutilizable para escribir a un contratista.
///
/// Hermana de `FormaPagoPlantilla`, y por el mismo motivo: los avisos que se
/// le mandan a un contratista se repiten semana tras semana —«recordatorio de
/// valorizacion», «manana no hay agua», «trae el SCTR»— y volver a teclearlos
/// hace que cada uno acabe diciendo algo distinto.
///
/// ES UNA PLANTILLA DE TEXTO, no un envio programado. Se copia al formulario
/// y **sigue siendo editable**: lo que se manda es lo que la persona ve antes
/// de pulsar, no lo que diga esta fila. Programar envios seria otra cosa, y
/// mucho mas delicada.
///
/// GCM no trae ninguna escrita: las palabras con las que una constructora le
/// habla a sus contratistas son suyas.
model PlantillaMensaje {
  id        String @id @default(cuid())
  companyId String

  /// Como se elige en el desplegable: "Recordatorio de valorizacion".
  nombre String @db.VarChar(100)

  /// El asunto, solo para correo. Vacio en una pensada para SMS o WhatsApp,
  /// que no tienen asunto.
  asunto String? @db.VarChar(200)
  /// El cuerpo, que vale para los tres canales.
  cuerpo String  @db.Text

  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, nombre])
  @@index([companyId])
  @@map("plantillas_mensaje")
}

model OrdenCompra {
  id          String @id @default(cuid())
  companyId   String
  projectId   String
  proveedorId String

  /// Contra que encargo se emite. NULL = orden SUELTA, que cuenta por si
  /// misma en el comprometido. Con encargo, el compromiso de la obra ya lo
  /// puso el monto contratado del encargo y la orden solo lo FORMALIZA:
  /// contarla ademas seria contar dos veces el mismo dinero. Es la decision
  /// de que el encargo es el contrato marco y manda sobre sus ordenes.
  encargoId String?

  /// El numero tal como lo escribe el cliente ("2026-07-00113").
  ///
  /// NO se genera ni se ordena por el: en las ordenes reales el correlativo
  /// no es cronologico —hay una de mayo con el 00121, posterior a una de
  /// julio con el 00113—, asi que ordenar por numero mentiria sobre la
  /// secuencia. Para eso esta `fecha`.
  numero String @db.VarChar(30)

  tipo   TipoOrden
  estado EstadoOrden @default(BORRADOR)

  /// Por donde entro. No cambia el comportamiento, pero sin esto no se puede
  /// responder a "esta cifra la tecleo alguien o la leyo un importador", que
  /// es la primera pregunta cuando un total no cuadra.
  origen OrigenRegistro @default(MANUAL)

  /// La del documento, no la del alta en el sistema.
  fecha DateTime @db.Date

  /// "EN ATENCION A: ORDEN DE COMPRA N° PERC218": la orden del cliente final.
  referencia String? @db.VarChar(60)

  /// La etiqueta que el papel llama "Partida" y es texto libre
  /// ("CRIOCORD ESTRUCTURAS METALICAS"). Se conserva como viene; la
  /// imputacion de verdad son las lineas de `OrdenImputacion`.
  descripcion String @db.VarChar(255)

  /// Texto y no un calendario de anticipos. Las tres ordenes analizadas
  /// tienen tres formas distintas —cinco adelantos con condiciones, "60% y
  /// saldo", 50/40/10—, y modelar un calendario sin haber visto como se
  /// pagan de verdad seria inventarlo. Llegara con el modulo de abonos.
  formaPago     String? @db.Text
  observaciones String? @db.Text

  /// Que impuesto lleva. NO es un detalle de presentacion: decide contra que
  /// cifra se mide el comprometido, y las ordenes reales del cliente traen
  /// los tres casos.
  tipoImpuesto TipoImpuesto @default(IGV)

  /// La cascada del papel. `neto` es el subtotal ya descontado, `impuesto` es
  /// el IGV o la retencion segun `tipoImpuesto`, y `total` es lo que sale del
  /// banco.
  ///
  /// El campo se llama `impuesto` y no `igv` a proposito: llamarlo igv
  /// mientras a veces guarda una retencion de renta invita justo al error de
  /// tratarla como credito fiscal y dejarla fuera del costo.
  subtotal           Decimal @db.Decimal(14, 2)
  descuentoComercial Decimal @default(0) @db.Decimal(14, 2)
  neto               Decimal @db.Decimal(14, 2)
  impuesto           Decimal @db.Decimal(14, 2)
  total              Decimal @db.Decimal(14, 2)

  aprobadaAt  DateTime?
  aprobadaPor String?   @db.VarChar(150)

  anuladaAt     DateTime?
  anuladaPor    String?   @db.VarChar(150)
  motivoAnulado String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  proveedor    Proveedor         @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  /// Restrict: un encargo con ordenes emitidas no desaparece en silencio;
  /// primero se decide que pasa con sus ordenes.
  encargo      EncargoProveedor? @relation(fields: [encargoId], references: [id], onDelete: Restrict)
  lineas       OrdenLinea[]
  imputaciones OrdenImputacion[]

  @@unique([companyId, numero])
  @@index([encargoId])
  @@index([projectId, estado])
  @@index([proveedorId])
  @@index([fecha])
  @@index([estado, fecha])
  @@index([total])
  @@map("ordenes_compra")
}

/// El detalle del papel. Opcional: las ordenes historicas se cargan solo por
/// cabecera, porque para el comprometido hacen falta los importes y no las
/// especificaciones de cada difusor.
model OrdenLinea {
  id      String @id @default(cuid())
  ordenId String

  /// Posicion en el documento. El orden del papel es informacion: agrupa.
  orden Int
  /// Profundidad. SIV AIRE llega a tres niveles.
  nivel Int @default(0)

  /// LA MARCA QUE EVITA CONTAR EL DINERO DOS VECES.
  ///
  /// Las ordenes reales abren cada bloque con una linea que REPITE la suma de
  /// sus hijas: "TOTAL ESTRUCTURAS 34,800.00" y debajo siete lineas que suman
  /// exactamente 34,800. Sumar en plano cuenta ese dinero dos veces, y en SIV
  /// AIRE tres. Es el mismo fallo de las celdas combinadas del Excel.
  esAgrupador Boolean @default(false)

  cantidad       Decimal? @db.Decimal(14, 4)
  unidad         String?  @db.VarChar(20)
  descripcion    String   @db.Text
  precioUnitario Decimal? @db.Decimal(14, 4)
  importe        Decimal  @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  ordenCompra OrdenCompra @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([ordenId])
  @@map("orden_lineas")
}

/// El reparto de la orden contra el presupuesto.
///
/// Existe porque las ordenes reales cruzan varias partidas: los S/ 159,450 de
/// SIV AIRE se reparten entre laboratorios, bunker y administracion. Con una
/// sola partida por orden, la desviacion de esa partida dejaria de significar
/// nada.
///
/// INVARIANTE: la suma de las imputaciones es igual al IMPORTE IMPUTABLE de la
/// orden, que NO siempre es el neto. Lo decide `lib/ordenes.importeImputable`:
/// con IGV es el neto —el IGV es credito fiscal y no costo de obra—, y con
/// retencion de renta o sin impuesto es el total, porque ahi no hay nada que
/// recuperar y quitarlo dejaria fuera un 8% de dinero comprometido de verdad.
/// Se comprueba al aprobar, como que una reconversion sume cero.
model OrdenImputacion {
  id        String @id @default(cuid())
  ordenId   String
  wbsItemId String

  importe Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  ordenCompra OrdenCompra @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  /// Restrict: una imputacion aprobada es dinero comprometido contra esa
  /// partida. Que choque aqui antes que desaparecer en silencio.
  partida     WbsItem     @relation(fields: [wbsItemId], references: [id], onDelete: Restrict)

  @@unique([ordenId, wbsItemId])
  @@index([wbsItemId])
  @@map("orden_imputaciones")
}

// ---------------------------------------------------------------------------
// Cronograma
//
// El plan lo manda MS Project y el avance real lo manda GCM. Ese reparto es la
// decision que gobierna estas cuatro tablas: cada lado escribe campos que el
// otro no toca, asi que reimportar NUNCA obliga a decidir quien gana.
//
// Anadir una partida en Project la hace aparecer al reimportar, sin avance.
// Alargar una duracion actualiza el plan sin tocar lo ya reportado.
// ---------------------------------------------------------------------------

/// Una importacion del cronograma. Se versiona en vez de pisarse: el historico
/// de cortes es lo que despues permite dibujar la curva S.
///
/// Si el plan no cambia respecto a la version anterior NO se crea una nueva.
/// Sin esa comprobacion, subir el archivo a diario llenaria el historial de
/// versiones gemelas y las reprogramaciones de verdad se perderian entre ellas.
model Cronograma {
  id        String @id @default(cuid())
  projectId String

  version Int

  /// El `<StatusDate>` del archivo: la fecha a la que estan referidos los
  /// avances que trae. Es la clave para avisar de que un corte ya se cargo.
  /// NO sirven `LastSaved` ni `CurrentDate`: hay dos exports del mismo corte
  /// guardados con cinco horas de diferencia.
  fechaCorte DateTime @db.Date

  /// El nombre de la obra segun el archivo. Sale de la primera fila real, no
  /// del titulo del documento: el titulo lleva la fecha y cambia cada semana.
  nombreProyecto String @db.VarChar(255)

  /// Minutos de jornada (`<MinutesPerDay>`, 480 en los archivos actuales). Se
  /// guarda porque de el dependen las conversiones de duracion y de desfase, y
  /// puede cambiar si el planificador altera el calendario. Cablearlo dejaria
  /// las cifras viejas incomparables con las nuevas y sin rastro del porque.
  minutosPorDia Int @default(480)

  /// El nombre del archivo del que salio. NULL cuando la version no salio de
  /// ningun archivo, sino de tareas tecleadas en GCM.
  archivo      String?  @db.VarChar(255)
  importadoAt  DateTime @default(now())
  importadoPor String   @db.VarChar(150)

  /// De donde salio esta version: `IMPORTADO` si la creo un archivo,
  /// `MANUAL` si nacio de teclear la primera tarea.
  ///
  /// Importa para la fecha de corte: un archivo trae su `<StatusDate>` y sin
  /// el se rechaza la importacion, porque inventar la fecha a la que estan
  /// referidos unos avances es mentir sobre ellos. Un cronograma tecleado no
  /// tiene esa fecha que respetar, y toma la del dia en que se empezo.
  origen OrigenRegistro @default(IMPORTADO)

  /// Linea base: con fecha, esta version es el plan CONGELADO contra el que se
  /// mide el EVM (PV/SPI). null = no es la base. Solo una version por obra la
  /// tiene a la vez; la unicidad se garantiza en el servicio (MariaDB no tiene
  /// indice unico parcial). Re-fijable: fijar otra version limpia esta.
  lineaBaseAt  DateTime?
  lineaBasePor String?   @db.VarChar(150)

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tareas       TareaCronograma[]
  dependencias DependenciaTarea[]

  @@unique([projectId, version])
  @@index([projectId, fechaCorte])
  @@map("cronogramas")
}

/// Una tarea del archivo, copiada fielmente. Es la foto del PLAN.
model TareaCronograma {
  id           String @id @default(cuid())
  cronogramaId String

  /// El `<UID>` de MS Project: lo unico estable entre semanas, y por tanto el
  /// ancla contra la que se guarda el avance. Comprobado con dos cortes
  /// reales: los `<GUID>` se regeneran enteros, el `<ID>` se corre al insertar
  /// o borrar, el `<WBS>` se recalcula con la posicion y el nombre se edita.
  /// Todos ellos fallan en silencio; este no.
  uid Int

  /// El numero de fila del archivo. Sirve para ordenar y para componer las
  /// cadenas de predecesoras del informe ("24FC+3 dias" usa la fila, no el
  /// UID). JAMAS como clave.
  fila Int

  /// El "4.4" del principio del nombre. Nulo cuando el nombre no lo trae —solo
  /// las filas de proyecto—. NO sale de `<WBS>`, que lleva la numeracion
  /// interna de Project ("1.5.4" para la partida 4.4).
  codigo String? @db.VarChar(40)
  nombre String  @db.VarChar(500)

  /// Profundidad de esquema (`<OutlineLevel>`). UNICA fuente de jerarquia: el
  /// codigo es una etiqueta y no la refleja. En el archivo real "7.3.1" es
  /// HERMANA de "7.3", no su hija, y las dos estan en el mismo nivel.
  nivel Int

  esResumen Boolean @default(false)
  esHito    Boolean @default(false)

  /// Viene dado por el archivo (`<Critical>`). No se deduce de la holgura: hay
  /// 18 tareas con holgura cero que NO son criticas.
  esCritico Boolean @default(false)

  inicio DateTime @db.Date
  fin    DateTime @db.Date

  /// La fila existe pero AUN NO SE HA PROGRAMADO: `inicio` y `fin` no son un
  /// plan, son solo el relleno que exige la columna.
  ///
  /// Nace asi la EDT generada desde el presupuesto, que trae la estructura y
  /// el dinero pero ninguna fecha. Sin esta marca el sistema no puede
  /// distinguir "sin programar" de "programada para el primer dia y con
  /// duracion cero", y esto ultimo significa VENCIDA: generar la EDT publicaba
  /// al instante cientos de alertas rojas falsas en el tablero y en el informe
  /// que se emite al cliente.
  sinProgramar Boolean @default(false)

  /// Sale de `<Duration>`, nunca de restar las fechas: una partida de un dia
  /// puede abarcar tres dias naturales por el calendario. Admite fraccion —en
  /// el archivo real hay una de 8,8 dias y el informe la imprime asi—.
  duracionDias Decimal @db.Decimal(8, 2)

  /// El "% Planeado" del archivo (campo personalizado Text1). Se LEE, no se
  /// calcula: asi las cifras coinciden con el informe que el cliente ya emite.
  porcentajePlaneado Decimal @db.Decimal(5, 2)

  /// El `<PercentComplete>` del archivo. Solo siembra el avance en la primera
  /// importacion; despues manda el que se reporta en GCM. Se conserva para
  /// poder ensenar la discrepancia entre lo que dice Project y lo reportado.
  porcentajeArchivo Decimal @db.Decimal(5, 2)

  /// Holgura total en dias. MSPDI omite el campo cuando vale cero, asi que la
  /// ausencia se guarda como 0 y se marca, para no confundir "sin holgura" con
  /// "no informado" al auditar.
  holguraDias     Decimal @default(0) @db.Decimal(8, 2)
  holguraInferida Boolean @default(false)

  /// De donde salio esta fila. `IMPORTADO` es lo que trajo un archivo;
  /// `MANUAL`, lo que se tecleo en GCM.
  ///
  /// Es lo que permite que reimportar NO se lleve por delante el trabajo a
  /// mano, igual que en el presupuesto: el archivo manda sobre lo que el
  /// archivo trajo, y no opina sobre lo demas.
  ///
  /// Las tareas MANUAL no traen predecesoras, asi que su ruta critica y su
  /// holgura no se conocen: nacen con `esCritico` en falso y
  /// `holguraInferida` en cierto. No se deducen, por la misma razon por la
  /// que `esCritico` tampoco se deduce de la holgura en las importadas.
  origen OrigenRegistro @default(IMPORTADO)

  cronograma Cronograma @relation(fields: [cronogramaId], references: [id], onDelete: Cascade)

  @@unique([cronogramaId, uid])
  @@index([cronogramaId, fila])
  @@map("tareas_cronograma")
}

/// Un enlace entre dos tareas del mismo cronograma.
///
/// Se guarda por UID y no por clave foranea a la tarea porque el predecesor
/// puede aparecer DESPUES en el documento —pasa en 16 de 76 enlaces— y la
/// resolucion es en dos pasadas.
model DependenciaTarea {
  id           String @id @default(cuid())
  cronogramaId String

  tareaUid       Int
  predecesoraUid Int

  /// FC (fin-comienzo), CC (comienzo-comienzo), FF (fin-fin), CF (comienzo-fin).
  /// Hoy el archivo solo trae FC y un CC, pero el mapeo va completo: un enlace
  /// mal tipado desplaza fechas sin dar ningun sintoma.
  tipo String @db.VarChar(2)

  /// Desfase en dias, con signo. El archivo lo trae en decimas de minuto.
  desfaseDias Decimal @default(0) @db.Decimal(8, 2)

  cronograma Cronograma @relation(fields: [cronogramaId], references: [id], onDelete: Cascade)

  @@index([cronogramaId, tareaUid])
  @@index([cronogramaId, predecesoraUid])
  @@map("dependencias_tarea")
}

/// El avance que se reporta desde obra. Es lo que GCM posee.
///
/// NO lleva clave foranea a `TareaCronograma`, y es deliberado: las versiones
/// del cronograma se sustituyen y el avance tiene que sobrevivirlas. Se ancla
/// en (projectId, uid), igual que `BaselineItem` duplica los datos en vez de
/// referenciar a `WbsItem` para sobrevivir a que se renombren partidas.
///
/// Cada reporte es una fila nueva, nunca un UPDATE: la curva S sale de la
/// serie historica, y saber quien dijo que una partida iba al 60% y cuando es
/// justamente lo que hoy se pierde al sobrescribir el porcentaje en Project.
model AvanceTarea {
  id        String @id @default(cuid())
  projectId String

  uid Int

  fecha      DateTime @db.Date
  porcentaje Decimal  @db.Decimal(5, 2)

  nota String? @db.Text

  reportadoPor String   @db.VarChar(150)
  createdAt    DateTime @default(now())

  /// Si el avance nacio al cerrar un Plan Semanal, apunta a ese plan: permite
  /// reemplazarlo al reabrir/re-cerrar y saber que vino del PTS. Los avances
  /// manuales (reportados a mano en el cronograma) lo dejan en null.
  planSemanalId String?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planSemanal PlanSemanal? @relation(fields: [planSemanalId], references: [id], onDelete: SetNull)

  @@index([projectId, uid])
  @@index([projectId, fecha])
  @@index([planSemanalId])
  @@map("avances_tarea")
}

/// Que partidas del presupuesto cubre cada tarea del cronograma.
///
/// Existe para poder PONDERAR EL AVANCE POR DINERO. Sin esto, el avance de la
/// obra es un promedio de porcentajes donde terminar una partida de 500 soles
/// pesa lo mismo que terminar una de 200.000, y la curva S no significa nada.
/// Con esto, el avance se expresa en soles y se puede contrastar con lo
/// comprometido en ordenes.
///
/// SE CONFIRMA A MANO, siempre. Se midio sobre los archivos reales de CRIOCORD
/// y enlazar por codigo automaticamente es peor que no enlazar: de las 56
/// coincidencias de codigo, 36 apuntaban a otra cosa —el capitulo 5 del
/// cronograma va desplazado una posicion respecto al del presupuesto, y el
/// "5.5" habria caido sobre un descuento comercial—. Un mapeo equivocado no da
/// ningun sintoma: la curva sale bonita y miente. GCM propone por codigo y por
/// parecido de descripcion; la fila solo se escribe cuando una persona acepta.
///
/// Es de UNA TAREA A VARIAS PARTIDAS: hay 314 partidas de presupuesto para 106
/// tareas, asi que el presupuesto es tres veces mas fino y una tarea cubre
/// varias. Ese reparto no lo deduce ningun algoritmo.
model MapeoTareaPartida {
  id        String @id @default(cuid())
  projectId String

  /// El `<UID>` de la tarea. Mismo ancla que `AvanceTarea`, por el mismo
  /// motivo: las versiones del cronograma se sustituyen.
  uid Int

  /// El codigo de la partida, NO su id. Reimportar el presupuesto borra las
  /// filas de `wbs_items` y las recrea con identificadores nuevos, asi que una
  /// clave foranea dejaria el mapeo roto —o lo borraria en cascada— cada vez
  /// que se corrige el Excel. El codigo sobrevive a eso.
  codigoPartida String @db.VarChar(32)

  /// Quien lo acepto y cuando. Que la fila exista significa que una persona lo
  /// reviso: las propuestas automaticas no se guardan, se calculan al vuelo.
  confirmadoPor String   @db.VarChar(150)
  confirmadoAt  DateTime @default(now())

  nota String? @db.Text

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, uid, codigoPartida])
  @@index([projectId, uid])
  @@index([projectId, codigoPartida])
  @@map("mapeo_tarea_partida")
}

/// Lo que hay que saber de un hito y no cabe en la tarea que lo representa.
///
/// Un hito ES una fila del cronograma con `esHito`: asi lo dibuja el Gantt —un
/// rombo, sin barra— y asi sale en la tabla de hitos. Lo que se guarda aqui es
/// lo que esa fila no puede llevar encima.
///
/// NO SON COLUMNAS DE `TareaCronograma`, y es deliberado. Las versiones del
/// cronograma se SUSTITUYEN enteras al importar un corte nuevo, asi que un
/// responsable escrito dentro de la tarea se perderia en el siguiente jueves.
/// Se ancla en `(projectId, uid)` sin clave ajena, que es la misma doctrina de
/// `AvanceTarea` y `MapeoTareaPartida`.
model HitoObra {
  id        String @id @default(cuid())
  projectId String

  /// El `uid` de la tarea que es este hito. Ancla estable, sin clave ajena.
  uid Int

  /// Tras que partida va en la EDT. El CODIGO, no el id, por lo mismo que en
  /// `MapeoTareaPartida`: reimportar el presupuesto recrea las filas con
  /// identificadores nuevos y el codigo sobrevive a eso.
  ///
  /// Nulo = el hito no cuelga de ninguna partida y vive al final. Es lo que
  /// queda tambien cuando la partida que lo anclaba desaparece.
  anclaCodigo String? @db.VarChar(32)

  /// Quien responde de que este hito se cumpla. Uno de los dos, nunca ambos:
  /// un usuario de GCM, o alguien de fuera. Lo valida el servicio, que la base
  /// no puede.
  ///
  /// Misma doctrina que las restricciones: el responsable es quien responde
  /// DENTRO de la organizacion, no el proveedor al que se persigue.
  responsableUserId     String?
  responsableContactoId String?

  /// Con cuantos dias de antelacion avisar de que se acerca.
  diasAviso Int @default(7)

  creadoPor String   @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// `SetNull` en los dos: dar de baja a alguien no puede borrar la traza de
  /// que un hito estuvo a su nombre.
  responsable User?          @relation("HitosResponsable", fields: [responsableUserId], references: [id], onDelete: SetNull)
  contacto    ContactoAviso? @relation(fields: [responsableContactoId], references: [id], onDelete: SetNull)

  @@unique([projectId, uid])
  @@index([projectId, anclaCodigo])
  @@index([responsableUserId])
  @@index([responsableContactoId])
  @@map("hitos_obra")
}

// ---------------------------------------------------------------------------
// Auditoria
//
// En un sistema que mueve dinero la trazabilidad no es opcional ni se
// agrega despues. Se registra desde el primer dia.
// ---------------------------------------------------------------------------

model AuditLog {
  id        String  @id @default(cuid())
  companyId String
  userId    String?
  projectId String?

  entidad   String      @db.VarChar(60)
  entidadId String      @db.VarChar(40)
  accion    AuditAction

  antes   Json?
  despues Json?

  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entidad, entidadId])
  @@index([userId, createdAt])
  @@index([companyId, entidad, createdAt])
  @@index([projectId, createdAt])
  @@index([accion, createdAt])
  @@map("audit_logs")
}

/// Cada vez que alguien descarga el respaldo completo de una obra.
///
/// Existe por una razon concreta: borrar una obra cerrada EXIGE haberla
/// respaldado antes, y "antes" hay que poder demostrarlo. Sin esta tabla la
/// condicion seria una casilla de la pantalla, es decir, una promesa.
///
/// Igual que `audit_logs`, `projectId` va SIN clave foranea a proposito: la
/// fila tiene que sobrevivir al borrado de la obra, que es justo el momento en
/// que pasa a importar. Por eso tambien se copian aqui el nombre y el
/// correlativo: cuando la obra ya no exista, esta fila tiene que seguir
/// diciendo de cual hablaba.
model RespaldoObra {
  id        String  @id @default(cuid())
  companyId String
  projectId String
  userId    String?

  /// Copiados de la obra: cuando se borre, esto es lo unico que queda.
  nombreObra  String  @db.VarChar(255)
  correlativo String? @db.VarChar(20)

  /// Version del formato del respaldo, para saber si un archivo viejo se
  /// puede seguir restaurando.
  formato Int

  /// SHA-256 de `datos.json`. Es lo que ata esta fila con el archivo que
  /// tiene el usuario en su disco: si no coincide, no es este respaldo.
  hashDatos String @db.VarChar(64)

  /// Tamaño del zip en bytes y conteo de filas por tabla, para poder decir
  /// "el respaldo llevaba 348 partidas" sin abrirlo.
  tamano   Int
  conteos  Json
  /// Si la evidencia viajo dentro del zip. Con obras de mucha foto puede
  /// quedarse fuera, y entonces el respaldo NO sirve para borrar.
  conFotos Boolean @default(true)

  createdAt DateTime @default(now())

  /**
   * SIN clave foranea a `companies` desde el 19/08/2026, y por el mismo motivo
   * por el que `projectId` nunca la tuvo.
   * Era `Cascade`, asi que borrar la constructora se llevaba por delante TODOS
   * los recibos de respaldo de sus obras: justo la prueba de que a esa empresa
   * se le entrego su informacion antes de destruirla. La tabla existe porque
   * «antes hay que poder demostrarlo», y una prueba que muere con lo que
   * prueba no prueba nada.
   */
  @@index([companyId, createdAt])
  @@index([projectId, createdAt])
  @@map("respaldos_obra")
}

/// Cada vez que alguien saca la constructora ENTERA para llevarla a otra
/// instalacion.
///
/// Hermana de `RespaldoObra` y por el mismo motivo: borrar una constructora
/// EXIGE haberla exportado antes, y "antes" hay que poder demostrarlo. El
/// apunte de auditoria de la exportacion no sirve para esto —se escribe al
/// EMPEZAR, porque alli lo que interesa es el intento— y una condicion no se
/// puede colgar de algo que significa "alguien lo intento".
///
/// SIN CLAVE FORANEA, y aqui la diferencia con `RespaldoObra` es el punto
/// entero: esta fila tiene que sobrevivir al borrado de la empresa, que es
/// justo el momento en que pasa a importar. Por eso se copian tambien la razon
/// social y el RUC: cuando la empresa ya no exista, esto es lo unico que queda
/// diciendo de cual hablaba.
///
/// LO QUE ESTA FILA NO DEMUESTRA: que quien exporto tenga el archivo guardado.
/// Prueba que GCM lo genero entero (se escribe cuando el zip termina de
/// salir), no que llegara a un disco. Nadie puede probar eso desde aqui, y la
/// pantalla lo dice en vez de aparentarlo.
model ExportacionEmpresa {
  id        String  @id @default(cuid())
  companyId String
  userId    String?

  razonSocial String @db.VarChar(200)
  ruc         String @db.VarChar(11)

  /// Version del formato de migracion, para saber si un archivo viejo se
  /// puede seguir importando.
  formato Int

  /// SHA-256 del manifiesto canonico. Ata esta fila con el zip que alguien
  /// tiene en su disco: si no coincide, no es esta exportacion.
  hashManifiesto String @db.VarChar(64)

  /// Bytes del zip, cuantas obras viajaron y filas por tabla, para poder decir
  /// "se llevo 4 obras y 348 partidas" sin abrirlo.
  tamano  Int
  obras   Int
  conteos Json

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("exportaciones_empresa")
}

// ---------------------------------------------------------------------------
// Encargos a proveedores (subcontratos por obra)
//
// Distinto de `ProveedorPartida`, que es un ATAJO —las partidas que un
// proveedor suele imputar, para que salgan primero al redactar una orden, y
// que NO limita nada—. Un encargo es lo contrario: el compromiso de que un
// proveedor se hace cargo de un FRENTE de la obra, con su precio pactado y su
// avance. Es el paso previo a las ordenes: primero repartes la obra entre
// proveedores, luego les vas emitiendo pedidos contra ese alcance.
//
// El precio del encargo (`montoContratado`) es el del PROVEEDOR y puede no
// coincidir con el parcial del presupuesto, que es TU costo estimado. Son dos
// cifras distintas y el modulo las compara sin mezclarlas.
// ---------------------------------------------------------------------------

/// VIGENTE mientras el proveedor trabaja; CERRADO cuando se liquida; ANULADO
/// si el encargo se deshizo. No se borra: un encargo con valorizaciones es
/// historia de la obra, igual que una orden anulada se conserva con su motivo.
enum EstadoEncargo {
  VIGENTE
  CERRADO
  ANULADO
}

enum EstadoPlanSemanal {
  ABIERTO
  CERRADO
}

/// Causas de no cumplimiento (CNC) del Last Planner: por que un compromiso de la
/// semana no se cumplio. Catalogo FIJO para poder comparar y hacer Pareto.
enum CausaNoCumplimiento {
  PRERREQUISITO
  MATERIALES
  MANO_OBRA
  EQUIPOS
  INFORMACION
  CLIENTE_TERCEROS
  CLIMA
  REPROGRAMACION
  OTRA
}

/// El analisis de causa raiz de una causa que se repite.
///
/// Cuelga del par OBRA + CAUSA, no del compromiso que fallo. La razon es que
/// la raiz no es del fallo: es del patron. Los seis incumplimientos de
/// MATERIALES de este mes no tienen seis raices, tienen una —«el proveedor
/// entrega los viernes y nosotros hormigonamos los jueves»— y un solo plan
/// que las resuelve todas. Colgarlo del compromiso obligaria a escribir seis
/// veces lo mismo, que es justo la burocracia que este sistema mide.
///
/// Cuando se pide esta en `@/lib/causa-raiz`: solo si la causa demuestra ser
/// patron. Aqui solo se guarda.
///
/// NO lleva unicidad por (obra, causa): un patron puede volver meses despues
/// con otra raiz, y el historial de lo que se intento vale mas que la
/// limpieza. Lo que si vale es que haya UNO abierto a la vez, y eso lo
/// garantiza el servicio —MariaDB no tiene indice unico parcial, el mismo
/// motivo por el que la linea base del cronograma se cuida desde el codigo—.
model AnalisisCausa {
  id        String              @id @default(cuid())
  projectId String
  causa     CausaNoCumplimiento

  /// La raiz, en las palabras de quien la vio. No es la causa —esa ya la dice
  /// el catalogo— sino POR QUE se repite esa causa en esta obra.
  porQue String @db.Text

  /// Que se va a hacer para que deje de pasar. Sin esto el analisis es un
  /// desahogo: describe el problema y no cambia nada.
  accion String @db.Text

  /// Quien se hace cargo y para cuando, igual que en una restriccion. Un plan
  /// sin nombre y sin fecha no es un plan.
  responsableUserId String?
  fechaCompromiso   DateTime? @db.Date

  /// Con fecha, el analisis esta cerrado: se dio por resuelto. No se borra,
  /// porque lo que se intento y no funciono es lo mas util del historial.
  cerradoAt  DateTime?
  cerradoPor String?   @db.VarChar(150)

  creadoPor String   @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// SetNull: dar de baja a alguien no puede borrar el analisis del que se
  /// hizo cargo. Misma doctrina que las restricciones.
  responsable User?   @relation("AnalisisResponsable", fields: [responsableUserId], references: [id], onDelete: SetNull)

  @@index([projectId, causa])
  @@index([projectId, cerradoAt])
  @@map("analisis_causa")
}

model EncargoProveedor {
  id          String @id @default(cuid())
  projectId   String
  proveedorId String

  /// Correlativo por obra ("E-001"), para nombrarlo en obra sin recitar el id.
  numero Int

  /// El frente en una linea, para leerlo sin abrir. "Estructura metalica ZONA 1".
  descripcion String @db.VarChar(300)

  /// Lo pactado con el proveedor por este frente, sin IGV para poder
  /// compararlo con el parcial del presupuesto, que tambien va sin IGV. Es SU
  /// precio, no el tuyo: puede quedar por encima o por debajo de tu costo.
  montoContratado Decimal @db.Decimal(14, 2)

  /// Que impuesto emite este proveedor. Se hereda del proveedor al crear el
  /// encargo y se guarda aqui para que el importe con impuesto no dependa de
  /// que el proveedor no cambie despues.
  tipoImpuesto TipoImpuesto @default(IGV)

  estado EstadoEncargo @default(VIGENTE)

  /// Fechas del encargo, si se pactaron. De calendario (`@db.Date`), como el
  /// resto de fechas de obra.
  fechaInicio DateTime? @db.Date
  fechaFin    DateTime? @db.Date

  notas String? @db.Text

  /// Cada cuantos dias le toca valorizar a ESTE contratista.
  ///
  /// `null` = HEREDA la cadencia de la obra, que es semanal atada a su
  /// `diaCorteSemanal`. Nula por defecto a proposito: la mayoria de los
  /// contratistas siguen el corte de la obra, y obligar a configurar uno por
  /// uno convertiria la funcion en una lista de pendientes que nadie llena.
  ///
  /// Si el encargo tiene `fechasValorizacion`, esas MANDAN sobre esto.
  cadenciaDias Int?

  creadoPor String   @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proveedor          Proveedor             @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  partidas           EncargoPartida[]
  valorizaciones     ValorizacionEncargo[]
  fechasValorizacion FechaValorizacion[]
  pagos              PagoEncargo[]
  /// Las ordenes emitidas CONTRA este encargo, que lo formalizan por partes.
  ordenes            OrdenCompra[]

  @@unique([projectId, numero])
  @@index([projectId, estado])
  @@index([proveedorId])
  @@index([projectId, fechaInicio])
  @@index([estado, fechaInicio])
  @@map("encargos_proveedor")
}

/// Que partidas —y que fraccion de cada una— entran en el encargo.
///
/// La fraccion existe porque, como pasa a menudo, una partida se reparte entre
/// dos proveedores: cada encargo lleva su parte y entre todos no deben pasar
/// del 100 % de la partida. Lo normal es 100 (la partida entera a un solo
/// proveedor), y ese es el valor por defecto.
model EncargoPartida {
  id        String @id @default(cuid())
  encargoId String
  wbsItemId String

  /// 0..100. Porcentaje del parcial de la partida asignado a ESTE encargo.
  fraccion Decimal @default(100) @db.Decimal(6, 3)

  encargo EncargoProveedor @relation(fields: [encargoId], references: [id], onDelete: Cascade)
  /// Restrict y no Cascade: una partida con encargo no se borra a la ligera
  /// —hay un compromiso con un proveedor colgando—; primero se quita del
  /// encargo. La linea base ya bloquea el borrado de partidas por su lado.
  partida WbsItem          @relation(fields: [wbsItemId], references: [id], onDelete: Restrict)

  @@unique([encargoId, wbsItemId])
  @@index([wbsItemId])
  @@map("encargo_partidas")
}

/// El avance del proveedor contra su encargo, con fecha y autor.
///
/// APPEND-ONLY, igual que el avance de las tareas: cada valorizacion es un
/// corte con su fecha, y la vigente es la mas reciente. Guardar la serie —y no
/// sobrescribir un unico porcentaje— es lo que permite ver el ritmo del
/// proveedor y saber quien reporto que, y cuando.
model ValorizacionEncargo {
  id        String @id @default(cuid())
  encargoId String

  /// La obra, DESNORMALIZADA: se llega igual por el encargo.
  ///
  /// No esta por comodidad de lectura sino porque sin columna no hay indice:
  /// el correlativo de obra necesita `@@unique([projectId, numeroObra])`, y
  /// una unicidad no se puede declarar sobre una columna de OTRA tabla. Sin
  /// ella, dos valorizaciones simultaneas en encargos distintos de la misma
  /// obra cogerian el mismo numero y nada lo rechazaria. Es el mismo motivo
  /// por el que `OrdenCompra` lleva `projectId` teniendo ya `encargoId`.
  ///
  /// El dueno del dato sigue siendo el encargo: esta columna se escribe una
  /// vez, al crear, y no se toca despues. Una valorizacion no cambia de obra.
  projectId String

  /// Fecha del corte de la valorizacion (calendario).
  fecha DateTime @db.Date

  /// EL numero del documento: "Valorizacion N.o 12" de esta OBRA. Correlativo
  /// por obra y ascendente, sin huecos mientras no se anule ninguna.
  ///
  /// Es el que manda en el papel, porque el papel lo emite la obra: quien lo
  /// archiva y quien lo reclama piensan en la obra, no en el contratista.
  numeroObra Int

  /// El correlativo dentro del ENCARGO: "la 3.a de este contratista".
  ///
  /// Por ENCARGO y no por proveedor, que es decision del usuario: el mismo
  /// contratista puede tener dos encargos en la misma obra —dos frentes con
  /// dos montos contratados y dos avances— y una serie compartida haria
  /// imposible leer "vamos por la tercera de la partida de acabados". Va al
  /// lado del de obra, nunca solo: por si mismo no identifica el documento.
  numeroEncargo Int

  /// Avance ACUMULADO del proveedor, 0..100, sobre su monto contratado.
  /// Acumulado y no incremental: es como se lee una valorizacion ("vamos al
  /// 45 %"), y restar dos cortes da el avance del periodo.
  porcentaje Decimal @db.Decimal(6, 3)

  nota String? @db.Text

  registradoPor String   @db.VarChar(150)
  createdAt     DateTime @default(now())

  encargo EncargoProveedor @relation(fields: [encargoId], references: [id], onDelete: Cascade)
  /// Cascade y no Restrict: la valorizacion ya moria con su encargo, y el
  /// encargo muere con la obra. Con Restrict aqui, borrar una obra chocaria
  /// contra esta clave y el borrado —que es reversible y esta probado— dejaria
  /// de funcionar por una columna que solo existe para numerar.
  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pagos   PagoEncargo[]

  /// Las dos series. Son tambien lo que impide el numero repetido: el numero
  /// se calcula dentro de la transaccion sobre el maximo actual, y si dos
  /// altas simultaneas leen el mismo maximo, la segunda choca aqui.
  @@unique([projectId, numeroObra])
  @@unique([encargoId, numeroEncargo])
  @@index([encargoId, fecha])
  @@map("valorizaciones_encargo")
}

/// Una fecha pactada de valorizacion para ESTE encargo (un hito de pago).
///
/// El segundo nivel de la cadencia, para el contratista que no valoriza cada
/// N dias sino en fechas acordadas ("al terminar el casco", "el 15 y el 30").
/// Si un encargo tiene fechas, MANDAN sobre la cadencia periodica: se pactaron
/// una a una, asi que son mas especificas que cualquier periodo.
model FechaValorizacion {
  id        String @id @default(cuid())
  encargoId String

  fecha DateTime @db.Date

  /// Como se llama ese hito en la conversacion con el contratista.
  descripcion String? @db.VarChar(200)

  createdAt DateTime @default(now())

  encargo EncargoProveedor @relation(fields: [encargoId], references: [id], onDelete: Cascade)

  @@unique([encargoId, fecha])
  @@index([encargoId, fecha])
  @@map("fechas_valorizacion")
}

/// Un pago hecho al contratista contra su encargo.
///
/// Cuelga del ENCARGO y no de la orden: el encargo es el contrato marco, y es
/// a el a quien se le paga. Ver la decision en el modelo de negocio —la
/// empresa subcontrata a todo riesgo y le paga al contratista, no al
/// proveedor de materiales—.
///
/// APPEND-ONLY como las valorizaciones: un pago no se edita, se registra. Si
/// se equivoco el importe, se registra el ajuste; lo pagado ya salio de caja
/// y el historico tiene que poder explicarlo.
model PagoEncargo {
  id        String @id @default(cuid())
  encargoId String

  /// La valorizacion que se esta pagando, si el pago corresponde a un corte
  /// concreto. Opcional: hay adelantos que no valorizan nada todavia, y
  /// pagos que cubren varios cortes. `SetNull` porque el pago sobrevive
  /// aunque el corte se rehaga.
  valorizacionId String?

  /// Lo pagado, en la moneda de la obra. Como todo el dinero aqui: Decimal,
  /// nunca coma flotante.
  monto Decimal @db.Decimal(14, 2)

  /// El dia en que salio el dinero (calendario), que no es el dia en que
  /// alguien lo tecleo: `createdAt` guarda eso.
  fecha DateTime @db.Date

  /// Quien lo registra, por nombre: tiene que seguir diciendolo aunque el
  /// usuario se desactive, igual que `registradoPor` de la valorizacion.
  registradoPor String @db.VarChar(150)

  nota String? @db.Text

  createdAt DateTime @default(now())

  encargo      EncargoProveedor     @relation(fields: [encargoId], references: [id], onDelete: Cascade)
  valorizacion ValorizacionEncargo? @relation(fields: [valorizacionId], references: [id], onDelete: SetNull)
  comprobantes ComprobantePago[]

  @@index([encargoId, fecha])
  @@index([valorizacionId])
  @@map("pagos_encargo")
}

/// El respaldo de un pago: la constancia de transferencia o la factura.
///
/// Tabla PROPIA y no un ancla mas de `FotoEvidencia`, a proposito: la
/// evidencia de obra se ensena en la galeria y en el informe —y la galeria
/// tiene un enlace que ve el CLIENTE—. Una constancia de pago a un
/// contratista no puede aparecer ahi por un descuido en un `where`.
///
/// Guarda lo mismo que `FotoEvidencia` y por los mismos motivos: el archivo
/// va al disco (`STORAGE_ROOT`), aqui solo su ruta, su tipo y su huella.
/// A diferencia de aquella, ADMITE PDF: una constancia bancaria casi nunca es
/// una foto, y un PDF no se puede comprimir en el navegador como una imagen.
model ComprobantePago {
  id     String @id @default(cuid())
  pagoId String

  /// Ruta RELATIVA dentro de STORAGE_ROOT ("pagos/<obra>/<id>.pdf").
  ruta String @db.VarChar(255)

  nombreOriginal String @db.VarChar(255)
  mimeType       String @db.VarChar(100)
  tamano         Int
  /// SHA-256 del contenido.
  hash           String @db.VarChar(64)

  subidoPor String   @db.VarChar(150)
  createdAt DateTime @default(now())

  pago PagoEncargo @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  @@index([pagoId])
  @@map("comprobantes_pago")
}

// ---------------------------------------------------------------------------
// Plan Semanal (Last Planner): compromisos, PPC y CNC
// ---------------------------------------------------------------------------

/// El plan semanal (Last Planner): lo que se COMPROMETE hacer en la semana que
/// cierra en su dia de corte. Al cerrarlo se mide el PPC (cumplidos/total) y las
/// causas de lo no cumplido (CNC). Correlacion por obra; una semana por corte.
model PlanSemanal {
  id        String @id @default(cuid())
  projectId String

  /// Correlativo por obra ("Semana 1"), para nombrarlo sin recitar el id.
  numero Int

  /// La semana que cubre, anclada a su dia de corte (la cadencia de la obra).
  fechaCorte DateTime @db.Date

  /// Cuando EMPIEZA la semana. Null = los siete dias hacia atras desde el
  /// corte, que es la cadencia normal y lo que valen todas las semanas
  /// existentes.
  ///
  /// Solo la PRIMERA semana de la obra puede arrancar antes: una obra que
  /// empieza un miercoles con corte en viernes dejaria sus dos primeros dias
  /// fuera de toda semana, y ese trabajo existe. Las demas semanas siguen
  /// siendo de siete dias para que el PPC se pueda comparar entre ellas.
  fechaInicio DateTime? @db.Date

  estado EstadoPlanSemanal @default(ABIERTO)

  notas String? @db.Text

  creadoPor  String    @db.VarChar(150)
  cerradoPor String?   @db.VarChar(150)
  cerradoAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  compromisos CompromisoSemanal[]
  avances     AvanceTarea[]

  @@unique([projectId, numero])
  @@unique([projectId, fechaCorte])
  @@index([projectId, estado])
  @@index([projectId, fechaCorte])
  @@index([estado, fechaCorte])
  @@map("planes_semanales")
}

/// Un compromiso de la semana: una tarea del cronograma (por uid) o una linea
/// libre. Al cerrar se marca cumplido/no y, si no, su causa (CNC).
model CompromisoSemanal {
  id            String @id @default(cuid())
  planSemanalId String

  /// UID de la tarea del cronograma comprometida; null si es una linea libre.
  uid Int?

  descripcion String @db.VarChar(300)

  /// % al que se compromete llegar en la semana. Opcional.
  metaPorcentaje Decimal? @db.Decimal(5, 2)

  /// null = sin evaluar; true/false al cerrar la semana. De esto sale el PPC.
  cumplido Boolean?

  /// Solo cuando `cumplido` es false: por que no se cumplio.
  causa CausaNoCumplimiento?

  notaCierre String? @db.Text

  /// Cuando el trabajo EMPEZO en obra. Null = prometido pero sin arrancar.
  ///
  /// Es la fecha de la TRANSICION y no un booleano, igual que `listaAt` o
  /// `analizadaAt`: guarda CUANDO paso, que es lo que permite medir cuanto
  /// tarda un compromiso en arrancar desde que se prometio.
  ///
  /// NO se deduce de `cantidadEjec`. Una cantidad ejecutada en cero puede
  /// significar «empezo y aun no hay avance medible» o «no ha empezado», y
  /// son cosas distintas: deducirlo es exactamente como una fila cambia de
  /// naturaleza sin que nadie lo note, que es el modo de fallo caro de esta
  /// aplicacion.
  enEjecucionAt DateTime?

  createdAt DateTime @default(now())

  // --- PTS operativo (Last Planner Fase 1): cantidad + zonificacion ---
  // El avance en % (metaPorcentaje + AvanceTarea) se MANTIENE; la cantidad es
  // complementaria y mas precisa (cantidad ejecutada vs planificada).

  /// De que tarea del Lookahead nace este compromiso (trazabilidad del PTS).
  /// Referencia suelta por valor; no FK dura para no atar su ciclo de vida.
  lookaheadTaskId String?

  /// Subcontratista asignado (proveedor de la empresa), si aplica.
  proveedorId String?

  /// Zona fina del trabajo ("P2-S1").
  zona String? @db.VarChar(40)

  /// Color (hex) para la vista de zonificacion del PTS.
  color String? @db.VarChar(9)

  /// Doble registro por CANTIDAD. `unidad` como el metrado de la partida.
  cantidadPlan Decimal? @db.Decimal(14, 4)
  cantidadEjec Decimal? @db.Decimal(14, 4)
  unidad       String?  @db.VarChar(20)

  /// Protocolo de calidad subido al completar (gate de calidad, Fase 4).
  protocoloCalidad Boolean @default(false)

  // --- Dia dentro de la semana (tablero de planificacion semanal) ----------
  //
  // El PTS comprometia POR SEMANA y el tablero de Last Planner se lee POR DIA:
  // filas por contratista, columnas por dia habil. Sin esto no hay donde
  // colocar la tarjeta.
  //
  // ISO 1-7 (lunes=1), la MISMA convencion que `Project.diaCorteSemanal` y
  // `WorkCalendar.diaSemana`. Se guarda el dia y no una fecha porque la semana
  // ya la fija `PlanSemanal.fechaCorte`: con una fecha suelta cabria escribir
  // un dia de otra semana y nada lo impediria.
  //
  // SON DOS Y NO UNO a proposito. La referencia del tablero habla de «que
  // actividad se completara cada dia», pero en obra un compromiso de tres dias
  // es lo normal, y meterlo en una sola columna haria que el tablero mintiera
  // sobre cuando ocupa el frente. Con inicio y fin la tarjeta se estira, como
  // el post-it estirado de la pizarra. Iguales = un solo dia.
  //
  // Nullable los dos: un compromiso sin dia sigue siendo valido —se pacto la
  // semana y aun no el dia— y el tablero lo enseña en su banda «sin dia» en
  // vez de esconderlo.
  diaInicio Int?
  diaFin    Int?

  plan      PlanSemanal     @relation(fields: [planSemanalId], references: [id], onDelete: Cascade)
  proveedor Proveedor?      @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  fotos     FotoEvidencia[]

  @@index([planSemanalId])
  @@index([proveedorId])
  @@map("compromisos_semanales")
}

// ---------------------------------------------------------------------------
// Last Planner: Lookahead (mediano plazo) y analisis de restricciones
// ---------------------------------------------------------------------------

enum TipoTurno {
  NORMAL
  NOCHE
  TURNOS
}

/// Estado de confiabilidad de una tarea del Lookahead. LISTO = sin restricciones
/// pendientes: es lo unico que se puede comprometer en el PTS.
enum EstadoLookahead {
  PENDIENTE
  LISTO
  BLOQUEADO
}

/// Los 7 flujos del analisis de restricciones (Last Planner).
enum TipoRestriccion {
  SEGURIDAD
  INFORMACION
  ESPACIO
  MATERIALES
  MANO_OBRA
  REQUISITOS
  EQUIPOS
}

/// Calendario laboral POR OBRA: que dias se trabaja y cuantas horas. Hasta ahora
/// solo existia `Project.diaCorteSemanal` (un dia de corte). El Lookahead
/// necesita los dias laborables para repartir tareas y contar plazos. Es por
/// obra —no por empresa— porque el sabado laborable de CRIOCORD (5h) puede no
/// aplicar a otra obra. ISO 1..7 (lunes=1), como `diaCorteSemanal`.
model WorkCalendar {
  id        String @id @default(cuid())
  projectId String

  /// Dia de la semana en ISO: 1=lunes … 7=domingo.
  diaSemana Int

  laborable Boolean @default(true)

  /// Horas del dia (8 de L a V, 5 el sabado de CRIOCORD, 0 si descanso).
  horas Decimal @default(8) @db.Decimal(4, 2)

  turno TipoTurno @default(NORMAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, diaSemana])
  @@index([projectId])
  @@map("calendarios_laborales")
}

/// Una tarea en la ventana de mediano plazo (Lookahead, ~3-6 semanas).
///
/// Se ancla a la tarea del cronograma por (projectId, uid) —igual que
/// `AvanceTarea`—: el uid es lo unico estable entre versiones. NO copia nombre
/// ni fechas (se leen de `TareaCronograma`). Solo guarda lo que ANADE la
/// planificacion operativa: fase, zona, subcontratista y las restricciones. La
/// partida se alcanza via `MapeoTareaPartida` por el mismo uid.
model LookaheadTask {
  id        String @id @default(cuid())
  projectId String

  /// UID de la tarea del cronograma (ancla estable entre versiones).
  uid Int

  /// Bloque/fase operativa para agrupar en la matriz ("FASE 2: ESTRUCTURAS").
  faseBloque String? @db.VarChar(120)

  /// Zona/sector de trabajo ("PISO 1", "ZONA A").
  zona String? @db.VarChar(80)

  /// Subcontratista responsable, si aplica.
  proveedorId String?

  /// GUID del elemento BIM, para el futuro enlace 4D. Sin uso todavia.
  bimGuid String? @db.VarChar(255)

  /// Estado de confiabilidad; LISTO lo calcula el backend desde `analizadaAt`
  /// y `restricciones` (ver `estadoDeTarea` en @/lib/lookahead).
  estado EstadoLookahead @default(PENDIENTE)

  /// Cuando paso a LISTO. Null mientras no lo este.
  ///
  /// Es la fecha de la TRANSICION, no del estado, y por eso solo se sella la
  /// primera vez (`listaAt: null` en el where de `recalcularEstados`). Sin esa
  /// guarda, cada recalculo la refrescaria y el aviso de "ya esta lista"
  /// saldria otra vez cada vez que alguien toca la matriz.
  listaAt DateTime?

  /// Cuando alguien reviso QUE flujos le aplican, y quien. Null = nadie la ha
  /// mirado, que NO es lo mismo que "revisada y no le aplica ninguna": las dos
  /// tienen cero restricciones, y sin esta fecha son la misma fila. De esa
  /// confusion venia que la confiabilidad midiera la falta de analisis en vez
  /// de la obra.
  analizadaAt  DateTime?
  analizadaPor String?   @db.VarChar(150)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proveedor     Proveedor?    @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  restricciones Restriccion[]

  @@unique([projectId, uid])
  @@index([projectId, estado])
  @@map("lookahead_tareas")
}

/// Una restriccion (analisis de restricciones) sobre una tarea del Lookahead.
/// Mientras alguna siga sin resolver, la tarea no esta LISTA y no puede
/// comprometerse: es el "filtro de confiabilidad" del Last Planner.
model Restriccion {
  id              String @id @default(cuid())
  lookaheadTaskId String

  tipo    TipoRestriccion
  detalle String?         @db.VarChar(300)

  /// Si exige un documento aprobado para resolverse (MATERIALES -> guia,
  /// INFORMACION -> RFI/plano). La validacion automatica es logica de backend.
  requiereDoc Boolean @default(false)

  /// Documento que la levanta, si `requiereDoc`. Sera FK a ProjectDocument en
  /// la Fase 4 (cuando exista la infra de subida de archivos).
  documentoId String?

  resuelta    Boolean   @default(false)
  resueltaAt  DateTime?
  resueltaPor String?   @db.VarChar(150)

  /// A QUIEN le toca levantarla. EXACTAMENTE UNO de los dos, o ninguno
  /// mientras nadie lo haya decidido. Lo valida el servicio; la base no puede.
  ///
  /// Sin esto, el analisis de restricciones no es un analisis de restricciones:
  /// el Last Planner pide una lista de restriccion -> responsable -> fecha en
  /// que promete liberarla, y lo que habia era una casilla que alguien marca.
  ///
  /// El responsable casi nunca es el proveedor: es quien puede levantarla
  /// DENTRO de la organizacion —el almacenero para MATERIALES, la oficina
  /// tecnica para INFORMACION—. El proveedor es a quien esa persona persigue.
  /// Ponerlo a el diluye la rendicion de cuentas, que es justo lo contrario de
  /// lo que busca el sistema. Se permite igual porque a veces si lo es, pero la
  /// pantalla ofrece primero a los de la obra.
  responsableUserId     String?
  responsableContactoId String?

  /// Para cuando prometio tenerla levantada.
  ///
  /// `@db.Date` porque es un DIA, no un instante, igual que
  /// `PlanSemanal.fechaCorte`: nadie promete un plano para las 14:32.
  fechaCompromiso DateTime? @db.Date

  /// Cuando se registro la promesa y quien la anoto.
  ///
  /// NO es lo mismo que quien promete. En obra la promesa llega por telefono y
  /// la escribe el residente, y esa diferencia hay que poder verla: una promesa
  /// que se hizo a si mismo el que la anota no vale lo mismo que una que hizo
  /// el almacenero delante de todos.
  comprometidoAt  DateTime?
  comprometidoPor String?   @db.VarChar(150)

  createdAt DateTime @default(now())

  tarea       LookaheadTask   @relation(fields: [lookaheadTaskId], references: [id], onDelete: Cascade)
  fotos       FotoEvidencia[]
  /// `SetNull` en los dos: dar de baja a alguien no puede borrar la traza de
  /// que una restriccion estuvo a su nombre.
  responsable User?           @relation("RestriccionesResponsable", fields: [responsableUserId], references: [id], onDelete: SetNull)
  contacto    ContactoAviso?  @relation(fields: [responsableContactoId], references: [id], onDelete: SetNull)

  /// Un flujo no puede estar dos veces en la misma tarea. Cuando se sembraban
  /// las 7 de golpe no hacia falta; ahora se anaden y se quitan de una en una,
  /// y un duplicado seria invisible: la matriz indexa por tipo y ensenaria uno
  /// mientras el otro cuenta para el estado. Cubre tambien el indice de la FK.
  @@unique([lookaheadTaskId, tipo])
  /// Para buscar las vencidas sin recorrer la tabla entera: el panel «Que
  /// falta» pregunta por ellas en cada carga del tablero.
  @@index([fechaCompromiso, resuelta])
  @@index([responsableUserId, resuelta])
  @@index([responsableContactoId])
  @@map("restricciones_tarea")
}

/// Evidencia fotografica (Last Planner): la foto adosada al dato donde se
/// decide, no una galeria suelta. Fase A: restricciones del Lookahead
/// (demostrar que se libero) y compromisos del PTS (documentar la causa de
/// no cumplimiento).
///
/// El archivo fisico vive FUERA del arbol de la app (STORAGE_ROOT); este
/// registro es la evidencia de auditoria y NUNCA se borra. La purga futura
/// eliminara el archivo del disco y marcara `purgadaAt`, dejando intactos
/// nombre, hash, tamano, quien y cuando.
model FotoEvidencia {
  id        String @id @default(cuid())
  projectId String

  /// A que se adosa: exactamente UNO de los tres. Lo valida el servicio; las
  /// FK van con SetNull para que la evidencia sobreviva aunque el objetivo
  /// desaparezca (el registro es inmutable, su ancla no).
  restriccionId String?
  compromisoId  String?

  /// El TERCER ancla: una tarea del cronograma, por su `uid`.
  ///
  /// Por valor y no por FK, igual que `AvanceTarea` y `MapeoTareaPartida`: el
  /// uid es estable entre versiones del cronograma, asi que la foto de una
  /// partida en ejecucion sobrevive a que se reimporte el plan. `fecha` es el
  /// dia que documenta —el del parte—, `@db.Date` como el resto de fechas de
  /// obra. Sin fecha (una foto general de la partida) sigue siendo valida: la
  /// fecha ordena el informe, no condiciona la existencia.
  uid   Int?
  fecha DateTime? @db.Date

  /// Pase de obra que la subio, si no la subio un usuario de GCM. Permite
  /// revisar de golpe todo lo que aporto una persona si su pase se revoca.
  /// `subidaPor` sigue guardando su nombre como texto: el registro tiene que
  /// seguir diciendo quien fue aunque el pase desaparezca.
  paseId String?

  /// Ruta RELATIVA dentro de STORAGE_ROOT (ej. "evidencia/<obra>/<id>.jpg").
  ruta String @db.VarChar(255)

  nombreOriginal String @db.VarChar(255)
  mimeType       String @db.VarChar(100)
  /// Bytes del archivo tal como se guardo.
  tamano         Int
  /// SHA-256 del contenido: la huella que sobrevive a la purga.
  hash           String @db.VarChar(64)

  /// Nota corta de quien sube ("llego el fierro de 3/8", "frente vacio").
  nota String? @db.VarChar(300)

  /// null = el archivo fisico existe. Con fecha = purgado del disco.
  purgadaAt DateTime?

  subidaPor String   @db.VarChar(150)
  createdAt DateTime @default(now())

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  restriccion Restriccion?       @relation(fields: [restriccionId], references: [id], onDelete: SetNull)
  compromiso  CompromisoSemanal? @relation(fields: [compromisoId], references: [id], onDelete: SetNull)
  pase        PaseObra?          @relation(fields: [paseId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([restriccionId])
  @@index([compromisoId])
  /// Para «las fotos de esta partida» (por uid) y el informe (por uid y dia).
  @@index([projectId, uid])
  @@index([paseId])
  @@map("fotos_evidencia")
}

// ---------------------------------------------------------------------------
// Galeria de la obra: fotos PARA ENSENAR, no para probar
//
// Es deliberadamente un mundo APARTE de `FotoEvidencia`. Aquella es registro
// probatorio: inmutable, adosada a una restriccion o a una causa, y jamas se
// borra. Esta es la cara de la obra —lo que el gerente repasa y lo que el
// cliente puede llegar a ver—, y por eso SE CURA: se describe, se destaca,
// se publica y, si una foto salio mal, se borra. Mezclarlas habria obligado
// a que curar el escaparate tocara el archivo probatorio.
// ---------------------------------------------------------------------------

/// Como se agrupa la galeria al ensenarla: por semana de calendario o por
/// mes. Semana DE CALENDARIO (lunes a domingo), no la del corte de la obra:
/// la galeria es para gente de fuera del Last Planner, y "la semana del 10"
/// se entiende sin explicar nada.
enum AgrupacionGaleria {
  SEMANA
  MES
}

model FotoGaleria {
  id        String @id @default(cuid())
  projectId String

  /// Ruta RELATIVA dentro de STORAGE_ROOT ("galeria/<obra>/<id>.jpg").
  /// Misma disciplina que la evidencia: fuera del arbol de la app, para que
  /// el despliegue no pueda llevarse las fotos por delante.
  ruta String @db.VarChar(255)

  nombreOriginal String @db.VarChar(255)
  mimeType       String @db.VarChar(100)
  /// Bytes del archivo tal como se guardo.
  tamano         Int
  /// SHA-256 del contenido. Ademas de integridad, es lo que permite que el
  /// respaldo de la obra adjunte el archivo sin recalcular nada.
  hash           String @db.VarChar(64)

  titulo      String? @db.VarChar(150)
  descripcion String? @db.VarChar(500)

  /// UID de la tarea del cronograma que retrata, hitos incluidos (un hito ES
  /// una tarea con `esHito`). Ancla (projectId, uid) y JAMAS clave foranea a
  /// `TareaCronograma`, por lo mismo que `AvanceTarea`: las versiones del
  /// cronograma se sustituyen enteras y la foto debe sobrevivirlas.
  uid Int?

  /// Si el enlace del cliente la ensena. APAGADA por defecto: publicar una
  /// foto de obra —que retrata personas y errores— es una decision, nunca
  /// un descuido.
  visibleCliente Boolean @default(false)

  subidaPor String   @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  portadaDe GaleriaObra[]

  @@index([projectId, createdAt])
  @@index([projectId, uid])
  @@index([projectId, visibleCliente])
  @@map("fotos_galeria")
}

/// La configuracion de la galeria de UNA obra, incluido el enlace publico
/// del cliente. Nace solo cuando alguien configura algo: la galeria funciona
/// sin esta fila, con sus valores por defecto.
model GaleriaObra {
  id        String @id @default(cuid())
  projectId String @unique

  /// La parte impredecible de la URL publica (`/galeria/<slug>`).
  ///
  /// Se guarda EN CLARO, al contrario que todos los demas tokens de la casa,
  /// y es deliberado: no es una credencial de entrada a GCM —abre solo las
  /// fotos que gerencia decidio publicar de UNA obra— y el gerente tiene que
  /// poder volver a copiar el enlace cuando quiera. Guardar el hash
  /// obligaria a rotar el enlace en cada copia, que es como se dejan de
  /// compartir las cosas. Revocar sigue siendo un clic: apagar o rotar.
  slug String @unique @db.VarChar(64)

  /// El enlace nace APAGADO: crear la configuracion no publica nada.
  activo Boolean @default(false)

  agrupacion AgrupacionGaleria @default(SEMANA)

  /// La foto que encabeza la galeria publica. SetNull: borrar la foto no
  /// puede tumbar la configuracion entera.
  portadaId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  portada FotoGaleria? @relation(fields: [portadaId], references: [id], onDelete: SetNull)

  @@map("galerias_obra")
}

// ---------------------------------------------------------------------------
// Pase de obra: quien documenta en campo SIN ser usuario de GCM
//
// El maestro, el capataz o el subcontratista no van a tener cuenta con
// contrasena: no la recordarian, y darles un `User` les abriria la puerta a
// un sistema que maneja dinero. El pase es deliberadamente otra cosa, y por
// eso vive en sus propias tablas: aunque alguien se equivoque, un pase NO
// puede hacer nada que un usuario pueda.
//
// Lo unico que permite es adjuntar fotos de evidencia, y solo en SU obra.
// ---------------------------------------------------------------------------

/// Una persona autorizada a documentar en una obra. La da de alta el
/// residente con los datos que ya toma de quien entra a la obra.
model PaseObra {
  id        String @id @default(cuid())
  projectId String

  nombres   String  @db.VarChar(100)
  apellidos String  @db.VarChar(100)
  cargo     String? @db.VarChar(100)
  /// Empresa a la que pertenece, si es de un subcontratista.
  empresa   String? @db.VarChar(150)

  /// Por donde se le hace llegar el codigo. Hace falta AL MENOS uno; lo
  /// valida el servicio. Un pase sin contacto no podria autenticarse nunca.
  celular String? @db.VarChar(30)
  email   String? @db.VarChar(150)

  /// Revocar NO borra: las fotos que subio siguen siendo evidencia y su
  /// autoria tiene que poder rastrearse. Solo deja de poder entrar.
  activo      Boolean   @default(true)
  revocadoAt  DateTime?
  revocadoPor String?   @db.VarChar(150)

  creadoPor String   @db.VarChar(150)
  createdAt DateTime @default(now())

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codigos  CodigoPase[]
  sesiones SesionPase[]
  fotos    FotoEvidencia[]

  /// Un mismo contacto no se repite dentro de la obra: si no, pedir codigo
  /// seria ambiguo y no se sabria a que pase pertenece la foto. MySQL admite
  /// varios NULL en un indice unico, asi que quien no tenga correo (o no
  /// tenga celular) no choca con los demas.
  @@unique([projectId, email])
  @@unique([projectId, celular])
  @@index([projectId, activo])
  @@map("pases_obra")
}

/// El codigo de un solo uso que se envia al pase. Calcado de `CodigoAcceso`
/// (la verificacion en dos pasos), que ya resolvio el problema: el codigo se
/// guarda HASHEADO, caduca pronto y se acaba a los cinco intentos.
model CodigoPase {
  id     String @id @default(cuid())
  paseId String

  /// Identifica el desafio; su token viaja en una cookie. No se guarda el
  /// id del pase en la cookie: si se guardara, cualquiera podria escribir el
  /// de otro y ponerse a probar seis cifras contra quien quisiera.
  tokenHash  String @unique @db.Char(64)
  /// SHA-256 del codigo de seis cifras. Nunca en claro.
  codigoHash String @db.Char(64)

  intentos  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  pase PaseObra @relation(fields: [paseId], references: [id], onDelete: Cascade)

  @@index([paseId])
  @@index([expiresAt])
  @@map("codigos_pase")
}

/// El telefono ya reconocido. Dura mucho a proposito: quien esta en obra con
/// las manos sucias no va a teclear un codigo cada media hora, y la friccion
/// es lo que mata la adopcion en campo.
///
/// Que dure tanto solo es aceptable porque lo que concede es minusculo:
/// anadir fotos a UNA obra. El control real no es la caducidad sino
/// `PaseObra.activo` y el estado de la obra, que se comprueban en cada
/// peticion; `expiresAt` es solo un techo para que una cookie olvidada no
/// viva para siempre.
model SesionPase {
  id     String @id @default(cuid())
  paseId String

  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  pase PaseObra @relation(fields: [paseId], references: [id], onDelete: Cascade)

  @@index([paseId])
  @@index([expiresAt])
  @@map("sesiones_pase")
}

/// Un SMS esperando a que el telefono emisor lo recoja.
///
/// GCM no manda SMS: los DEJA AQUI, y un telefono con la SIM de la empresa
/// pregunta cada pocos segundos si hay algo que mandar. Se invirtio el
/// sentido a proposito. La alternativa —que GCM llamara al telefono— exige
/// una aplicacion Android propia, y mantener viva una app contra el gestor
/// de bateria de cada fabricante es otro producto, no una funcion de esta.
/// Asi el lado del telefono es configuracion (MacroDroid o Tasker, que ya
/// existen) y no hay una linea de codigo movil que mantener.
///
/// EL PUNTO DEBIL, dicho en voz alta: aqui el codigo del pase esta EN CLARO,
/// porque hay que poder mandarlo. Quien obtenga el token de la cola lee los
/// codigos del personal antes que ellos. Lo que lo acota:
///
/// - el texto se borra en cuanto el emisor confirma que salio (`enviadoAt`),
///   asi que la ventana es de segundos, no de dias;
/// - `expiraAt` corta los que ya no sirven aunque nadie los recoja;
/// - el codigo del pase caduca solo a los diez minutos y admite tres
///   intentos, que es la red que habia debajo de todo esto.
model MensajeSms {
  id String @id @default(cuid())

  /// De quien es este mensaje. Sin esto la cola era UNA para toda la
  /// plataforma, y el telefono de una constructora recogia y mandaba los
  /// codigos de otra.
  companyId String

  /// Celular como lo guarda GCM (nueve cifras). Si algun dia hace falta el
  /// prefijo de pais, se anade al ENTREGARLO, no aqui.
  numero String @db.VarChar(20)

  /// El texto del SMS. Se vacia al confirmar el envio: a partir de ese
  /// momento la fila sirve para saber que salio, no para saber que decia.
  texto String @db.VarChar(320)

  /// Cuando un emisor se lo llevo. Es un prestamo, no una entrega: si no
  /// confirma dentro de la gracia, el mensaje vuelve a ofrecerse. Mandar dos
  /// veces el mismo codigo es inofensivo; no mandarlo, no.
  tomadoAt DateTime?

  /// Cuando el emisor confirmo que el SMS salio de la SIM.
  enviadoAt DateTime?

  /// Cuantas veces se ha ofrecido. Un numero alto delata un emisor que
  /// recoge y nunca confirma —telefono sin saldo, permiso de SMS revocado—.
  entregas Int @default(0)

  /// Que sale antes cuando hay cola.
  ///
  /// Los codigos de acceso y de pase CADUCAN a los diez minutos; un aviso de
  /// restriccion no caduca. Sin esto, diez avisos encolados por delante pueden
  /// dejar a alguien sin poder entrar en su cuenta por culpa de un aviso de
  /// materiales. Los codigos encolan con 10, los avisos con 0.
  ///
  /// La solucion NO es subir `MAXIMO_POR_ENTREGA`: ese tope protege la SIM del
  /// corte por antispam. Lo que hay que ordenar es la cola, no ensancharla.
  prioridad Int @default(0)

  /// A partir de aqui ya no vale la pena mandarlo: el codigo que lleva
  /// dentro habra caducado igualmente.
  expiraAt  DateTime
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// De que obra salio, cuando sale de una. Null en lo que no es de obra —un
  /// codigo de acceso a GCM—. Se anadio con los avisos: sin esto no habia
  /// forma de contar cuantos SMS gasta una obra, y el tope diario necesita
  /// saberlo.
  projectId String?

  /// El indice de la consulta que corre cada pocos segundos. Empieza por la
  /// empresa porque ahora cada emisor solo ve la suya.
  ///
  /// `prioridad` NO va aqui a proposito: anadirla obliga a MySQL a soltar y
  /// rehacer la clave ajena que se apoya en este indice, y eso es un riesgo
  /// real —perder la integridad referencial de la cola— a cambio de ahorrar
  /// una ordenacion sobre las pocas filas que devuelve la consulta.
  @@index([companyId, enviadoAt, expiraAt])
  /// Para el tope diario de SMS de aviso por obra.
  @@index([projectId, createdAt])
  @@map("mensajes_sms")
}

/// Por donde salio un mensaje a un contratista.
enum CanalMensaje {
  CORREO
  SMS
  WHATSAPP
}

/// Quien escribio: la constructora o el contratista.
///
/// Se anade a la MISMA tabla en vez de crear otra para las respuestas: una
/// conversacion es una sola cosa, y dos tablas obligarian a mezclarlas y
/// ordenarlas por fecha en cada pantalla, y a tratarlas dos veces en el
/// respaldo y en el borrado de obra.
enum DireccionMensaje {
  SALIENTE
  ENTRANTE
}

/// Lo que se le ha escrito a un contratista, y por donde.
///
/// EXISTE PARA PODER DECIR «te avise el martes». GCM ya sabia a quien tenia
/// contratado en cada frente, pero hablarle obligaba a salirse a WhatsApp,
/// y entonces la unica constancia quedaba en el telefono de una persona —que
/// se va de la empresa, o cambia de movil—.
///
/// NO GUARDA LOS ADJUNTOS, solo sus nombres y su tamano. Se decidio asi: el
/// archivo ya viajo en el correo y esta en la bandeja de enviados de quien lo
/// mando; guardarlo aqui obligaria a meterlo en el respaldo, en el borrado de
/// obra y en la restauracion para no dejar huerfanos, a cambio de poco.
///
/// `projectId` NO tiene clave foranea, igual que en `MensajeSms` y por el
/// mismo motivo: el mensaje es del CONTRATISTA, no de la obra. Al borrar una
/// obra se pone a null y la ficha del contratista conserva su historial.
model MensajeContratista {
  id          String @id @default(cuid())
  companyId   String
  proveedorId String

  /// De que obra salio, cuando sale de una. Null cuando se escribe desde el
  /// catalogo de empresa, que es una conversacion sin frente de por medio.
  projectId String?

  canal CanalMensaje

  /// El correo o el celular al que fue. Se guarda el de ENTONCES: si manana
  /// el contratista cambia de numero, el historial tiene que seguir diciendo
  /// a donde se mando, no a donde se mandaria hoy.
  destino String @db.VarChar(150)

  /// Solo el correo lo tiene.
  asunto String? @db.VarChar(200)

  cuerpo String @db.Text

  /// Nombres y tamanos de lo que se adjunto. Nunca el contenido.
  adjuntos Json?

  /// A donde iba la respuesta. Sirve para saber a quien le llego el «no me
  /// llego el plano» cuando quien pregunta ya no esta en la empresa.
  respuestaA String? @db.VarChar(150)

  /// Si GCM lo entrego al canal.
  ///
  /// WHATSAPP se queda SIEMPRE en false, y no es un fallo: GCM no envia por
  /// WhatsApp —la API oficial exige cuenta Business verificada—, solo prepara
  /// el texto para que lo mande la persona desde su telefono. Marcarlo como
  /// enviado seria decir que llego algo que GCM no ha mandado.
  enviado Boolean

  /// Por que no salio, cuando no salio.
  motivo String? @db.VarChar(60)

  enviadoPor String   @db.VarChar(150)
  createdAt  DateTime @default(now())

  /// Quien escribio. Lo existente es todo SALIENTE, de ahi el valor por
  /// defecto: la migracion no tiene que tocar ni una fila.
  direccion DireccionMensaje @default(SALIENTE)

  /**
   * El identificador del hilo, en los SALIENTES por correo.
   * Viaja dentro del `Message-ID` que GCM fija al enviar
   * (`<gcm.TOKEN@dominio>`). Cuando el contratista pulsa «Responder», su
   * cliente lo devuelve en `In-Reply-To`, y eso es lo que ata la respuesta a
   * ESTA conversacion: mismo contratista y misma obra, sin adivinar.
   * Aleatorio y no el `id` de la fila: un identificador adivinable dejaria
   * inyectar respuestas falsas mandando un correo al buzon.
   */
  token String? @db.VarChar(40)

  /// El mensaje que contesta, en los ENTRANTES. Sin clave ajena, igual que
  /// `projectId` y por lo mismo: la respuesta sobrevive a que se purgue lo
  /// que contestaba.
  enRespuestaA String? @db.VarChar(30)

  /**
   * Quien lo escribio, para poder AVISARLE cuando llegue la respuesta.
   * `enviadoPor` es un nombre para mostrar y no sirve para eso. Sin clave
   * ajena a proposito: el mensaje es historia y tiene que sobrevivir a que su
   * autor se dé de baja, igual que sobrevive a que se borre la obra.
   */
  userId String? @db.VarChar(30)

  /**
   * El `Message-ID` del correo ENTRANTE. Es la clave de la idempotencia.
   * El buzon no se marca ni se vacia —es de la constructora y lo usa gente—,
   * asi que la misma pasada puede volver a ver el mismo correo. Lo que impide
   * duplicarlo es este indice unico, no el estado del buzon. Es la misma
   * doctrina de `EnvioAviso`: la clave se reserva, no se confia en la memoria.
   */
  messageIdEntrante String? @db.VarChar(255)

  proveedor Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  /// Que el mismo correo no entre dos veces. Por empresa: dos constructoras
  /// pueden recibir copia del mismo correo y cada una guarda el suyo.
  @@unique([companyId, messageIdEntrante])
  /// El historial de la ficha del contratista.
  @@index([proveedorId, createdAt])
  /// Para poder ver lo escrito desde una obra.
  @@index([projectId, createdAt])
  /// Para encontrar la conversacion a la que responde un correo entrante.
  @@index([companyId, token])
  @@map("mensajes_contratista")
}

// ---------------------------------------------------------------------------
// Avisos: que lo que GCM ya sabe llegue a quien puede resolverlo
// ---------------------------------------------------------------------------
//
// El Lookahead sabe que a una tarea le falta el plano, y lo sabe con dias de
// antelacion. Hasta ahora habia que entrar a mirarlo. El Pareto de la primera
// obra real lo dijo sin ambiguedad: 5 de 5 incumplimientos por "prerrequisito
// o tarea previa", ni una sola barra mas. No faltaba material ni cuadrilla;
// faltaba que alguien se enterara a tiempo.
//
// Tres piezas: a QUIEN se avisa (`SuscripcionAviso`), gente de fuera a la que
// tambien hay que escribir (`ContactoAviso`), y el aviso que se queda dentro
// de GCM (`Aviso`). El reloj que dispara lo periodico vive en `RelojTarea`.

/// Alguien de FUERA de GCM a quien hay que avisar: el proveedor que trae el
/// fierro, el proyectista que responde la RFI.
///
/// NO es un `PaseObra`, y la diferencia importa: aquel es una CREDENCIAL —da
/// entrada a una obra y arrastra codigo y sesion— y esto es una libreta de
/// direcciones. Reutilizarlo obligaria a dar de alta gente EN la obra solo
/// para poder escribirle, que es conceder de mas por comodidad.
model ContactoAviso {
  id        String @id @default(cuid())
  projectId String

  nombre  String  @db.VarChar(150)
  empresa String? @db.VarChar(150)
  cargo   String? @db.VarChar(100)

  /// Hace falta AL MENOS uno de los dos o la fila es una fila muerta: no
  /// habria por donde avisarle. Misma regla que `validarAltaPase`. El celular
  /// se guarda normalizado (nueve cifras) porque `enviarSms` no acepta otra
  /// cosa.
  celular String? @db.VarChar(20)
  email   String? @db.VarChar(150)

  /// Dar de baja NO borra: los avisos que ya se le mandaron siguen teniendo a
  /// quien senalar.
  activo    Boolean   @default(true)
  bajaAt    DateTime?
  creadoPor String    @db.VarChar(150)
  createdAt DateTime  @default(now())

  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suscripciones SuscripcionAviso[]
  /// Restricciones de las que se hizo cargo. Alguien de fuera puede ser el
  /// responsable de levantar una, aunque no sea lo habitual ni lo deseable.
  restricciones Restriccion[]
  /// Hitos de los que responde. Mismo caso: la supervision externa o el
  /// cliente pueden responder de una fecha clave.
  hitos         HitoObra[]

  /// MySQL admite varios NULL en un indice unico, asi que esto no estorba a
  /// quien solo tiene correo o solo celular.
  @@unique([projectId, email])
  @@unique([projectId, celular])
  @@index([projectId, activo])
  @@map("contactos_aviso")
}

/// Una regla de aviso: A QUIEN, DE QUE y POR DONDE.
///
/// Las tres formas de decir "a quien" —una persona, un rol, alguien de
/// fuera— viven en la MISMA tabla porque son la misma pregunta con distinto
/// sujeto. Partirlas en tres obligaria a tres consultas, tres pantallas y
/// tres formas de duplicar al mismo destinatario sin darse cuenta.
model SuscripcionAviso {
  id        String @id @default(cuid())
  projectId String

  /// EXACTAMENTE UNO de los tres. La base no puede exigirlo; lo valida
  /// `validarSuscripcion` en @/lib/avisos, que esta probado.
  userId     String?
  /// Quien tenga ese rol EN ESTA OBRA (`ProjectMembership`), no en la
  /// empresa: un residente puede llevar una obra y solo mirar otra.
  rol        Role?
  contactoId String?

  /// Null = todos los flujos. Con valor = solo ese. Es lo unico que separa al
  /// responsable de MATERIALES del de INFORMACION, que era el encargo.
  tipo TipoRestriccion?

  /// Por donde. Booleanos y no un array de texto: se filtran en SQL y se leen
  /// sin descifrar nada.
  porApp    Boolean @default(true)
  porCorreo Boolean @default(true)
  /// Apagado por defecto A PROPOSITO: el SMS sale de una SIM real de la
  /// empresa y se paga. Encenderlo es una decision, no un descuido.
  porSms    Boolean @default(false)

  /// Cuando. Los cuatro momentos, cada uno por separado.
  alAbrir       Boolean @default(true)
  alRecordar    Boolean @default(true)
  /// Apagado por defecto: "ya puedes comprometerla" es una buena noticia, y
  /// las buenas noticias son las primeras que se aprenden a ignorar.
  alQuedarLista Boolean @default(false)
  enResumen     Boolean @default(true)

  creadoPor String   @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacto ContactoAviso? @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  @@index([projectId, tipo])
  @@map("suscripciones_aviso")
}

/// Por donde sale un aviso. APP es la campanita; los otros dos cuestan buzon
/// ajeno o dinero de la linea.
enum CanalAviso {
  APP
  CORREO
  SMS
}

/// Que momento genero el aviso.
enum EventoAviso {
  /// Se acaba de decidir que a una tarea le falta este flujo.
  ABRIR
  /// Lleva demasiados dias sin levantarse y la tarea se acerca.
  RECORDAR
  /// La tarea quedo LISTA: ya se puede comprometer en el PTS.
  LISTA
  /// El repaso del dia, agrupado.
  RESUMEN

  /// Una fecha clave se acerca y sigue sin cumplirse. Suena UNA VEZ, al entrar
  /// en la ventana de antelacion del hito.
  HITO_CERCA
  /// Una fecha clave paso sin cumplirse. Insiste cada `diasRecordatorio`.
  HITO_VENCIDO

  /// A un contratista le toco valorizar y no consta el corte.
  ///
  /// AVISA, NO BLOQUEA: decision del usuario. El avance de la obra no se
  /// detiene porque un contratista deba una valorizacion; lo que no puede
  /// pasar es que nadie se entere hasta que llegue la factura.
  VALORIZACION_PENDIENTE

  /// Un contratista contesto a un mensaje de la obra.
  ///
  /// Va a QUIEN ESCRIBIO, no a la obra entera: es su conversacion. Y solo
  /// existe cuando la respuesta se pudo atar a una obra, porque `Aviso`
  /// requiere `projectId`; las respuestas que no se atan viven en la ficha
  /// del contratista y no suenan.
  RESPUESTA_CONTRATISTA

  /// Una nota con fecha de recordatorio vencio y sigue sin atenderse.
  ///
  /// Igual que VALORIZACION_PENDIENTE: solo campanita, insiste cada dia
  /// mientras siga vencida y sin atender. Antes de esto, un recordatorio
  /// vivia solo en el widget del tablero: si nadie abria el panel ese dia,
  /// era como si no existiera.
  NOTA_VENCIDA
}

/// El aviso dentro de GCM.
///
/// Persistido y con "leido" POR USUARIO. El "no leido" de `ActividadReciente`
/// vive en `localStorage`, o sea por NAVEGADOR: sirve para una lista que se
/// mira, no para saber si a alguien le llego algo.
model Aviso {
  id        String @id @default(cuid())
  companyId String
  projectId String

  /// Null cuando el destinatario es de fuera de GCM: no tiene bandeja donde
  /// ensenarselo, pero el aviso se registra igual para poder decir a quien se
  /// escribio y cuando.
  userId String?

  evento EventoAviso
  titulo String      @db.VarChar(200)

  /// Que se rompe si no se atiende, no solo el hecho. Es la misma linea del
  /// panel «Que falta»: "3 restricciones abiertas" no mueve a nadie.
  cuerpo String @db.VarChar(400)
  /// Donde se arregla. Ruta relativa a la obra, como en `Pendiente.camino`.
  camino String @db.VarChar(200)

  leidoAt   DateTime?
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// El indice de la campanita: lo no leido de una persona, lo mas nuevo
  /// primero.
  @@index([userId, leidoAt, createdAt])
  @@index([projectId, createdAt])
  @@map("avisos")
}

/// Que se mando, a quien y por donde. Es lo que impide que el reloj repita.
///
/// NO va en `AuditLog`, y no por comodidad: esta tabla no es un registro para
/// leer, es una CLAVE UNICA que se reserva ANTES de enviar. Esa es la unica
/// forma de que dos pasadas solapadas del cron no manden el mismo correo dos
/// veces —y de que, si el cron estuvo caido tres horas, lo de esas tres horas
/// salga una sola vez cuando vuelva—.
///
/// Es ademas el contador de los topes: cuantos SMS lleva hoy esta empresa.
model EnvioAviso {
  id        String @id @default(cuid())
  companyId String
  projectId String

  evento EventoAviso
  canal  CanalAviso

  userId     String?
  contactoId String?

  /// La compone `claveDeAviso` en @/lib/avisos. Lleva el dia dentro cuando el
  /// aviso se repite (recordatorio, resumen) y no lo lleva cuando es de una
  /// sola vez (se abrio, quedo lista).
  clave String @db.VarChar(120)

  /// Correo o celular al que fue, para poder responder "¿le llego?" sin
  /// reconstruirlo. Nunca se ensena fuera de la pantalla de configuracion.
  destino String @db.VarChar(150)

  enviado Boolean
  /// "sin-canal", "tope-persona", "tope-empresa", "smtp"... Para la pantalla
  /// del que configura, no para el destinatario.
  motivo  String? @db.VarChar(60)

  createdAt DateTime @default(now())

  /// El que hace idempotente al reloj. Se reserva antes de enviar.
  @@unique([projectId, canal, clave])
  /// El indice de los topes: cuantos SMS lleva hoy esta empresa.
  @@index([companyId, canal, createdAt])
  @@map("envios_aviso")
}

/// Lo que se ajusta de los avisos EN UNA OBRA.
///
/// Por obra y no por empresa, con el mismo argumento que `WorkCalendar`: el
/// proyectista de una obra no es el de la siguiente, y la cadencia con que
/// conviene insistir depende de como va cada una.
model AjustesAvisosObra {
  projectId String @id

  /// Apagarlo todo de golpe, sin desmontar la configuracion.
  activo Boolean @default(true)

  /// Cada cuantos dias insiste el recordatorio. Cada N dias y no todos los
  /// dias a partir del N: un recordatorio diario se ignora a la semana y
  /// molesta desde el segundo.
  diasRecordatorio Int @default(3)

  /// Hora local (Peru) a la que sale el resumen. 0..23.
  horaResumen Int @default(7)

  /// Tope de SMS al dia PARA ESTA OBRA.
  maxSmsDia Int @default(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("ajustes_avisos_obra")
}

/// Cuando corrio por ultima vez cada tarea programada.
///
/// GCM no tenia NADA que corriera solo: la purga de la cola de SMS cuelga del
/// latido del telefono emisor por eso mismo. Los recordatorios y el resumen
/// diario no pueden depender de que un movil este encendido, asi que los
/// dispara un cron del servidor contra `/api/reloj`.
///
/// Esta tabla existe por dos razones, y la segunda es la importante: para no
/// repetir el resumen del dia, y para poder DECIR que el cron lleva horas sin
/// correr. Un aviso que falla en silencio es peor que no tenerlo, porque
/// nadie lo echa de menos hasta que ya paso lo que iba a avisar.
model RelojTarea {
  /// "avisos". Corta y estable: se escribe en el codigo.
  clave String @id @db.VarChar(40)

  /// Cuando arranco la pasada en curso. Con `terminadaAt` null y esto
  /// reciente, hay una corriendo y la siguiente se declina: solaparse no
  /// romperia nada —lo impide el unico de `EnvioAviso`— pero gasta el doble
  /// de conexiones al SMTP para nada.
  iniciadaAt  DateTime
  /// Se escribe TAMBIEN cuando la pasada falla. Una que revienta y deja esto
  /// en null bloquearia el reloj para siempre.
  terminadaAt DateTime?

  /// Por donde iba: la ultima obra mirada. Null = empezar por el principio.
  /// El recorrido es circular, y las obras se miran de pocas en pocas porque
  /// recorrerlas todas en una peticion es lo que LiteSpeed corta.
  cursor String? @db.VarChar(60)

  obrasVistas   Int     @default(0)
  avisosCreados Int     @default(0)
  error         String? @db.VarChar(300)

  @@map("reloj_tareas")
}

// ---------------------------------------------------------------------------
// Presupuesto meta y bolsa operativa
//
// `Baseline` es el presupuesto CONTRACTUAL: lo que el cliente paga, con su
// cascada de gastos generales y utilidad en porcentaje. El presupuesto META es
// el otro: lo que la empresa se compromete a GASTAR. La diferencia entre los
// dos es la BOLSA OPERATIVA de la obra, y sin ella nadie sabe si se esta
// ganando o perdiendo hasta la liquidacion.
//
// Vive en tablas propias, y NO como un `tipo` dentro de `Baseline`, por dos
// motivos. El primero es de riesgo: hay nueve `baseline.findFirst` repartidos
// por seis servicios, sin punto unico, y un discriminador los volveria
// ambiguos a todos de golpe; olvidar uno no da error, da una cifra creible.
// El segundo es de forma: la meta no tiene utilidad, y sus gastos generales no
// son un porcentaje. Compartir tabla obligaria a arrastrar dos columnas con la
// regla no escrita "en la meta van en cero", que es una invariante que nada
// hace cumplir.
// ---------------------------------------------------------------------------

/// Con que detalle se compara la meta contra el contractual.
///
/// Se elige por obra al crear la meta y queda FIJO para esa version: cambiarlo
/// con datos dentro obliga a decidir que se hace con lo ya cargado, y la
/// respuesta honesta suele ser que se pierde. Para cambiar de modo se crea una
/// version nueva de la meta.
enum ModoPresupuestoMeta {
  /// Espeja el arbol contractual linea a linea. La bolsa sale por partida.
  PARTIDA
  /// Solo cabeceras de capitulo. La bolsa sale por capitulo.
  CAPITULO
  /// Estructura propia por frentes de produccion, con reparto a partidas.
  FRENTE
}

/// Las dos clases de gasto general, que se comportan al reves ante un atraso.
enum TipoGastoGeneral {
  /// No depende del plazo: cartas fianza, licencias, polizas, gastos de
  /// licitacion. Un mes mas de obra no los mueve.
  FIJO
  /// Por mes: staff, oficina, camioneta, servicios. Son los que sangran
  /// cuando la obra se estira, y por eso se guardan con su monto mensual y
  /// sus meses en vez de con un total ciego.
  VARIABLE
}

/// El presupuesto meta de una obra: lo que la empresa se compromete a gastar.
///
/// Versionado y congelable como `Baseline`, y por el mismo motivo: si la meta
/// se pudiera editar despues, la bolsa seria teatro —bastaria bajarla cuando
/// te pasas de gasto— y todos los indicadores mentirian hacia atras.
model PresupuestoMeta {
  id        String @id @default(cuid())
  projectId String

  version Int

  modo ModoPresupuestoMeta

  /// Fecha a la que se fija la meta. Como en `Baseline.fechaRevision`, no
  /// coincide con `createdAt`: una meta del 03/06 puede cargarse despues.
  fechaMeta DateTime @db.Date

  notas String? @db.Text

  // --- Las tres cifras de la meta ----------------------------------------
  //
  // AQUI NO HAY UTILIDAD, Y ES A PROPOSITO. La utilidad no es un costo que se
  // pueda gastar: es el resultado. Metida en la meta se vuelve gastable, el
  // equipo de obra se la come sin darse cuenta y nadie lo nota hasta la
  // liquidacion. La utilidad contractual vive en `Baseline.porcentajeUtilidad`
  // y se ensena aparte, etiquetada como lo que es. Si alguien viene a anadirla
  // aqui "por completitud", esto es lo que tiene que leer antes.
  //
  // Tampoco hay un porcentaje de gastos generales: en la meta son una lista
  // con plazo (`GastoGeneralMeta`), porque escalan con los MESES y no con la
  // produccion. Un porcentaje sobre el costo directo esconde justo el modo de
  // falla mas caro: la obra que se estira con todas sus partidas en meta.

  /// Suma de los items de la meta.
  costoDirecto Decimal @db.Decimal(14, 2)

  /// Suma de `GastoGeneralMeta`. Derivada, se persiste para no recalcular la
  /// lista en cada consulta de tablero.
  gastosGenerales Decimal @db.Decimal(14, 2)

  /// costoDirecto + gastosGenerales. El COSTO al que se compromete la obra,
  /// que es la cifra que se compara con el presupuesto de venta.
  costoTotal Decimal @db.Decimal(14, 2)

  /// Plazo en meses con el que se presupuestaron los gastos generales
  /// variables.
  ///
  /// Se GUARDA, no se deriva de `Project.fechaFinProgramada`. Si se derivara,
  /// atrasar la obra reescribiria la meta hacia atras: los gastos generales
  /// meta subirian solos para encajar con la fecha nueva y siempre cuadrarian,
  /// con lo que la desviacion de plazo —el sobrecosto mas caro que tiene una
  /// obra— desapareceria de la pantalla. Congelado, el atraso se ve.
  ///
  /// Se propone desde las fechas de la obra al crear la meta, y desde ahi es
  /// suyo.
  mesesPlazo Decimal @db.Decimal(5, 2)

  // --- Contra que se fijo -------------------------------------------------
  //
  // La bolsa se calcula contra el presupuesto VIGENTE (base + movimientos
  // aprobados), no contra la base: si no, un adicional aprobado no contaria.
  // Pero eso abre un agujero: el contractual sube por el adicional y la meta
  // no incluye lo que cuesta construirlo, asi que la bolsa se infla sola.
  // Estos dos campos son lo que permite detectarlo y decir CUANTO.

  /// Version de la linea base contra la que se fijo esta meta.
  baselineVersion Int?

  /// Cuantos movimientos aprobados habia en la obra al fijarla. Si despues hay
  /// mas, la meta esta desfasada y la bolsa exagera: ver `desfaseDeMeta`.
  movimientosAlFijar Int @default(0)

  /// null = borrador editable. Con fecha = CONGELADA e inmutable.
  aprobadaAt  DateTime?
  aprobadaPor String?   @db.VarChar(150)

  creadaPor String   @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items                PresupuestoMetaItem[]
  gastosGeneralesLista GastoGeneralMeta[]

  @@unique([projectId, version])
  @@index([projectId])
  @@map("presupuestos_meta")
}

/// Una linea del presupuesto meta.
///
/// Copia por valor, sin FK al arbol vivo, por el mismo motivo que
/// `BaselineItem`: la meta debe sobrevivir intacta aunque despues se renombren
/// o eliminen partidas del presupuesto.
model PresupuestoMetaItem {
  id                String @id @default(cuid())
  presupuestoMetaId String

  /// Codigo de la partida o capitulo contractual que espeja esta linea.
  ///
  /// Este unico campo nullable es lo que hace que los modos PARTIDA y CAPITULO
  /// salgan de la MISMA tabla a distinta profundidad, sin ramas en el modelo:
  /// en PARTIDA apunta a codigos de partida, en CAPITULO a codigos de
  /// capitulo, y el calculo de la bolsa solo cambia por donde une.
  ///
  /// null = LINEA PROPIA DE LA META: un costo real que el contractual no
  /// desglosa —andamio alquilado, cuadrilla de apoyo, encofrado metalico— y
  /// que por tanto no tiene contra que compararse linea a linea, pero si
  /// cuenta en el total del capitulo y de la obra.
  ///
  /// En modo FRENTE va siempre en null: ahi la correspondencia con el
  /// presupuesto no es un codigo sino un reparto, y vive en `MetaItemPartida`.
  codigoRef String? @db.VarChar(32)

  descripcion String  @db.VarChar(500)
  tipo        WbsType
  nivel       Int     @default(0)
  orden       Int     @default(0)

  unidad         String?  @db.VarChar(20)
  metrado        Decimal? @db.Decimal(14, 4)
  precioUnitario Decimal? @db.Decimal(14, 4)
  parcial        Decimal? @db.Decimal(14, 2)

  /// Fecha opcional escrita en la plantilla. Viaja sin tocar hasta el
  /// contractual (`generarContractual` en `contractual-desde-meta.ts`) y de
  /// ahi a `WbsItem.fechaInicioPlan/fechaFinPlan` -aqui no se USA, solo se
  /// guarda lo que trajo el Excel para que el contractual pueda copiarla.
  fechaInicioPlan DateTime? @db.Date
  fechaFinPlan    DateTime? @db.Date

  /// Solo en CAPITULOS: cuanto se recarga este capitulo del presupuesto real
  /// para llegar al presupuesto contractual.
  ///
  /// Se guarda COMO PORCENTAJE, no como fraccion: 18.000 son 18%. Es lo que
  /// se escribe en la plantilla y lo que ensena la hoja, y guardarlo igual
  /// evita el error de cien veces, que en un presupuesto no da error: da una
  /// cifra creible y equivocada. Para calcular, `porcentajeAFraccion`.
  porcentajeRecargo Decimal?          @db.Decimal(6, 3)
  meta              PresupuestoMeta   @relation(fields: [presupuestoMetaId], references: [id], onDelete: Cascade)
  reparto           MetaItemPartida[]

  @@index([presupuestoMetaId, orden])
  @@index([presupuestoMetaId, codigoRef])
  @@map("presupuesto_meta_items")
}

/// Reparto de una linea de meta entre las partidas del contractual. SOLO en
/// modo FRENTE.
///
/// Un frente de produccion ("Estructura ZONA 1") no coincide con una partida
/// del contrato: toca varias, y a veces solo una parte de cada una. Sin este
/// reparto no hay forma de comparar la meta con el presupuesto, porque no
/// hablan el mismo idioma.
///
/// Es la MISMA forma que `EncargoPartida`, a proposito: la logica de reparto
/// por fraccion ya esta escrita y probada en `lib/encargos.ts` y se reutiliza
/// en vez de escribir una segunda que se comporte distinto en los bordes.
model MetaItemPartida {
  id         String @id @default(cuid())
  metaItemId String
  wbsItemId  String

  /// 0..100. Porcentaje del parcial de la partida que cubre ESTA linea de la
  /// meta. Entre todas las lineas no deben pasar del 100 % de la partida.
  fraccion Decimal @default(100) @db.Decimal(6, 3)

  item    PresupuestoMetaItem @relation(fields: [metaItemId], references: [id], onDelete: Cascade)
  /// Restrict, como en `EncargoPartida`: una partida repartida en una meta no
  /// se borra a la ligera; primero se quita del reparto.
  partida WbsItem             @relation(fields: [wbsItemId], references: [id], onDelete: Restrict)

  @@unique([metaItemId, wbsItemId])
  @@index([wbsItemId])
  @@map("meta_item_partidas")
}

/// Un gasto general de la meta.
///
/// No es un porcentaje: es una linea con su plazo. Los VARIABLE llevan monto
/// mensual y meses, y de ahi sale su total; los FIJO llevan el total directo y
/// dejan los otros dos en null. Que un VARIABLE si los lleve lo valida el
/// servicio: la base no puede expresar esa condicion.
///
/// Guardar el mensual y los meses por separado —en vez de un total ciego— es
/// lo que permite decir cuanto cuesta CADA MES de atraso, que es la pregunta
/// que se hace en obra cuando el plazo se va.
model GastoGeneralMeta {
  id                String @id @default(cuid())
  presupuestoMetaId String

  concepto String           @db.VarChar(200)
  tipo     TipoGastoGeneral

  /// Solo en VARIABLE. En FIJO van en null.
  montoMensual Decimal? @db.Decimal(14, 2)
  meses        Decimal? @db.Decimal(5, 2)

  /// En VARIABLE, montoMensual * meses. En FIJO, el importe tal cual. Se
  /// persiste para no tener que multiplicar en cada suma y para que un FIJO y
  /// un VARIABLE se puedan sumar sin preguntar de que tipo son.
  montoTotal Decimal @db.Decimal(14, 2)

  orden Int @default(0)

  meta PresupuestoMeta @relation(fields: [presupuestoMetaId], references: [id], onDelete: Cascade)

  @@index([presupuestoMetaId, orden])
  @@map("gastos_generales_meta")
}

// ---------------------------------------------------------------------------
// Notas y recordatorios: la bitacora libre de la obra
// ---------------------------------------------------------------------------

/// Las cuatro categorias fijas del lanzamiento. Un catalogo cerrado y no
/// texto libre: el filtro y el widget del tablero necesitan agrupar por algo
/// estable, y una etiqueta escrita a mano nunca coincide dos veces igual.
enum CategoriaNota {
  FINANCIERO
  LOGISTICA
  OPERATIVO
  LEGAL
}

/// Una entrada de la bitacora de la obra: lo que no encaja en ningun
/// formulario reglado —un hallazgo, un pago pendiente, un tema legal, un
/// recordatorio suelto—. NO es una Restriccion: esa vive en el Lookahead,
/// tiene tipo cerrado, responsable y fecha de COMPROMISO, y bloquea una tarea
/// concreta. Una Nota no tiene responsable ni compromete a nadie: es texto
/// libre con, como mucho, una fecha en la que alguien quiere que se la
/// recuerden.
///
/// NO GUARDA "vencida". Vencida = pendiente (no atendida) + fechaRecordatorio
/// en el pasado, y eso se deriva SIEMPRE en el servicio (`esVencida` en
/// `@/lib/notas`), nunca en una columna: una columna se desincroniza en
/// cuanto pasa un dia sin que nadie toque la fila, y entonces miente.
model Nota {
  id        String @id @default(cuid())
  companyId String
  projectId String

  categoria CategoriaNota

  /// Encabezado corto, lo que se lee en la lista y en el widget del tablero.
  titulo String @db.VarChar(150)
  /// El cuerpo libre. Text y no VarChar: a diferencia del cuerpo de un
  /// Aviso —una linea de notificacion, acotada a 400—, esto es la nota en
  /// si, y puede ser tan larga como haga falta.
  cuerpo String @db.Text

  /// Cuando alguien quiere que se lo recuerden. NULL = nota sin recordatorio:
  /// no puede estar vencida y no aparece en el widget de proximos
  /// recordatorios, solo en la bitacora.
  fechaRecordatorio DateTime? @db.Date

  atendida    Boolean   @default(false)
  atendidaAt  DateTime?
  atendidaPor String?   @db.VarChar(150)

  /// Quien la escribio, tal como `EncargoProveedor.creadoPor` y
  /// `Restriccion.resueltaPor`: sin FK a proposito. Una Nota es historial
  /// permanente de la obra, y desactivar la cuenta de quien la escribio no
  /// tiene por que borrar lo que anoto.
  creadoPor String @db.VarChar(150)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  adjuntos AdjuntoNota[]

  /// Alimenta el widget de "proximos recordatorios" y el contador de
  /// vencidas del riel de la obra: notas pendientes con recordatorio,
  /// ordenadas por fecha.
  @@index([projectId, atendida, fechaRecordatorio])
  @@index([projectId, createdAt])
  @@map("notas")
}

/// Un archivo colgado de una Nota —el comprobante de un pago, el documento
/// legal, la foto del hallazgo—.
///
/// A diferencia de `FotoEvidencia`, que es prueba de campo inmutable con su
/// propio ciclo de purga, un adjunto de Nota es contenido de autor: vive y
/// muere con la nota (`onDelete: Cascade`, no `SetNull`), y borrarlo es un
/// gesto normal de edicion, no algo que deje rastro de auditoria aparte del
/// `AuditLog` que ya escribe el servicio. Por eso no lleva `hash` ni
/// `purgadaAt`: no hay nada que sobreviva a su borrado a proposito.
model AdjuntoNota {
  id        String @id @default(cuid())
  notaId    String
  /// Denormalizado desde `Nota.projectId`, igual que `FotoEvidencia`: filtrar
  /// por obra sin tener que pasar por un `include` de la nota.
  projectId String

  /// Ruta RELATIVA dentro de STORAGE_ROOT (ej. "notas/<obra>/<id>.pdf").
  ruta String @db.VarChar(255)

  nombreOriginal String @db.VarChar(255)
  mimeType       String @db.VarChar(100)
  /// Bytes del archivo tal como se guardo.
  tamano         Int

  subidaPor String   @db.VarChar(150)
  createdAt DateTime @default(now())

  nota    Nota    @relation(fields: [notaId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([notaId])
  @@index([projectId])
  @@map("adjuntos_nota")
}
